{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Kafka": "kafka:9092"
  },
  "CacheSettings": {
    "Host": "redis",
    "Port": 6379,
    "DefaultTtlSeconds": 300
  },
  "Services": {
    "WorkflowServiceUrl": "http://workflow-service:8081",
    "FileServiceUrl": "http://file-service:8081"
  }
}
