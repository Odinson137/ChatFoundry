{
  "ReverseProxy": {
    "Routes": {
      "workflow-route": {
        "ClusterId": "workflow",
        "AuthorizationPolicy": "workflow",
        "Match": { "Path": "/workflow/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/workflow" }
        ]
      },

      "client-route": {
        "ClusterId": "client",
        "AuthorizationPolicy": "client",
        "Match": { "Path": "/client/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/client" }
        ]
      },

      "telegram-route": {
        "ClusterId": "telegram",
        "AuthorizationPolicy": "telegram",
        "Match": { "Path": "/telegram/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/telegram" }
        ]
      },

      "telegram-hook-route": {
        "ClusterId": "telegram",
        "AuthorizationPolicy": "Anonymous",
        "Match": {
          "Path": "/telegram/hook/{**catch-all}",
          "Headers": [
            {
              "Name": "X-Telegram-Bot-Api-Secret-Token",
              "Values": [ "REPLACE_FROM_ENV" ],
              "Mode": "ExactHeader"
            }
          ]
        },
        "Transforms": [
          { "PathRemovePrefix": "/telegram" }
        ]
      },
      
      "identity-token": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/identity/connect/token"
        },
        "Transforms": [
          { "PathRemovePrefix": "/identity" }
        ]
      },
      
      "identity-route": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "identity",
        "Match": { "Path": "/identity/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/identity" }
        ]
      },

      "company-route": {
        "ClusterId": "company",
        "AuthorizationPolicy": "company",
        "Match": { "Path": "/company/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/company" }
        ]
      },
      "file-route": {
        "ClusterId": "file",
        "AuthorizationPolicy": "workflow",
        "Match": { "Path": "/file/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/file" }
        ]
      }
    },

    "Clusters": {
      "workflow": {
        "Destinations": {
          "d1": { "Address": "http://workflow-service:8080/" }
        }
      },
      "client": {
        "Destinations": {
          "d1": { "Address": "http://client-service:8080/" }
        }
      },
      "telegram": {
        "Destinations": {
          "d1": { "Address": "http://telegram-service:8080/" }
        }
      },
      "identity": {
        "Destinations": {
          "d1": { "Address": "http://identity-service:8080/" }
        }
      },
      "company": {
        "Destinations": {
          "d1": { "Address": "http://company-service:8080/" }
        }
      },
      "file": {
        "Destinations": {
          "d1": { "Address": "http://file-service:8080/" }
        }
      }
    }
  }
}
