{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "workflow-route": {
        "ClusterId": "workflow-cluster",
        "Match": {
          "Path": "/workflow/{**catch-all}"
        },
        "AuthorizationPolicy": "workflow-scope"
      }
    },
    "Clusters": {
      "workflow-cluster": {
        "Destinations": {
          "workflow-service": {
            "Address": "http://workflow-service:8080/"
          }
        }
      }
    }
  },
  "AllowedHosts": "*"
}
