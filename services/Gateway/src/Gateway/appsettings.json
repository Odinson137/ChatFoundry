{
  "ReverseProxy": {
    "Routes": {
      "workflow-route": {
        "ClusterId": "workflow",
        "AuthorizationPolicy": "workflow",
        "Match": { "Path": "/workflow/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/workflow" }
        ]
      },

      "client-route": {
        "ClusterId": "client",
        "AuthorizationPolicy": "client",
        "Match": { "Path": "/client/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/client" }
        ]
      },

      "telegram-route": {
        "ClusterId": "telegram",
        "AuthorizationPolicy": "telegram",
        "Match": { "Path": "/telegram/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/telegram" }
        ]
      },

      "hook-route": {
        "ClusterId": "telegram",
        "Match": { "Path": "/telegram/hook/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/telegram" }
        ]
      },
      
      "identity-token": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/identity/connect/token"
        },
        "Transforms": [
          { "PathRemovePrefix": "/identity" }
        ]
      },
      
      "identity-route": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "identity",
        "Match": { "Path": "/identity/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/identity" }
        ]
      }
    },

    "Clusters": {
      "workflow": {
        "Destinations": {
          "d1": { "Address": "http://workflow-service:8080/" }
        }
      },
      "client": {
        "Destinations": {
          "d1": { "Address": "http://client-service:8080/" }
        }
      },
      "telegram": {
        "Destinations": {
          "d1": { "Address": "http://telegram-service:8080/" }
        }
      },
      "identity": {
        "Destinations": {
          "d1": { "Address": "http://identity-service:8080/" }
        }
      }
    }
  }
}
