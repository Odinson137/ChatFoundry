{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=client_db;Port=5432;Database=foundry_db;Username=foundry;Password=foundry",
    "Kafka": "kafka:9092"
