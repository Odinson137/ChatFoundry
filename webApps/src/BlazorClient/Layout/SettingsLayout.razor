@layout MainLayout
@using Microsoft.AspNetCore.Components.Routing
@inherits LayoutComponentBase

<div class="settings-layout">
    <aside class="settings-sidebar">
        <div class="settings-sidebar-header">
            <div class="settings-sidebar-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="3"/>
                    <path d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 010 2.83 2 2 0 01-2.83 0l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-4 0v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 01-2.83-2.83l.06-.06A1.65 1.65 0 004.68 15a1.65 1.65 0 00-1.51-1H3a2 2 0 010-4h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 012.83-2.83l.06.06A1.65 1.65 0 009 4.68a1.65 1.65 0 001-1.51V3a2 2 0 014 0v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 012.83 2.83l-.06.06A1.65 1.65 0 0019.4 9a1.65 1.65 0 001.51 1H21a2 2 0 010 4h-.09a1.65 1.65 0 00-1.51 1z"/>
                </svg>
            </div>
            <div class="settings-sidebar-title">
                <span class="settings-sidebar-title-text">Настройки</span>
                <span class="settings-sidebar-title-sub">Управление компанией</span>
            </div>
        </div>
        <nav class="settings-nav">
            <div class="settings-nav-group">
                <div class="settings-nav-group-title">
                    <span class="settings-nav-group-line"></span>
                    <span>Общее</span>
                    <span class="settings-nav-group-line"></span>
                </div>
                <NavLink class="settings-nav-item" href="/settings" Match="NavLinkMatch.All">
                    <span class="snav-icon snav-icon--indigo">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/>
                        </svg>
                    </span>
                    <span class="snav-text">Обзор</span>
                    <span class="snav-arrow">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
                    </span>
                </NavLink>
                <NavLink class="settings-nav-item" href="/settings/members">
                    <span class="snav-icon snav-icon--emerald">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/>
                        </svg>
                    </span>
                    <span class="snav-text">Участники</span>
                    <span class="snav-arrow">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
                    </span>
                </NavLink>
                <NavLink class="settings-nav-item" href="/settings/invitations">
                    <span class="snav-icon snav-icon--violet">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/>
                        </svg>
                    </span>
                    <span class="snav-text">Приглашения</span>
                    <span class="snav-arrow">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
                    </span>
                </NavLink>
            </div>

            <div class="settings-nav-group">
                <div class="settings-nav-group-title">
                    <span class="settings-nav-group-line"></span>
                    <span>Конфигурация</span>
                    <span class="settings-nav-group-line"></span>
                </div>
                <NavLink class="settings-nav-item" href="/settings/channels">
                    <span class="snav-icon snav-icon--sky">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/>
                        </svg>
                    </span>
                    <span class="snav-text">Каналы</span>
                    <span class="snav-arrow">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
                    </span>
                </NavLink>
                <NavLink class="settings-nav-item" href="/settings/attributes">
                    <span class="snav-icon snav-icon--orange">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="4 17 10 11 4 5"/><line x1="12" y1="19" x2="20" y2="19"/>
                        </svg>
                    </span>
                    <span class="snav-text">Атрибуты</span>
                    <span class="snav-arrow">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
                    </span>
                </NavLink>
                <NavLink class="settings-nav-item" href="/settings/files">
                    <span class="snav-icon snav-icon--rose">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M13 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V9z"/><polyline points="13 2 13 9 20 9"/>
                        </svg>
                    </span>
                    <span class="snav-text">Файлы</span>
                    <span class="snav-arrow">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
                    </span>
                </NavLink>
            </div>

            <div class="settings-nav-group">
                <div class="settings-nav-group-title">
                    <span class="settings-nav-group-line"></span>
                    <span>Разработка</span>
                    <span class="settings-nav-group-line"></span>
                </div>
                <NavLink class="settings-nav-item" href="/settings/api">
                    <span class="snav-icon snav-icon--indigo">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>
                        </svg>
                    </span>
                    <span class="snav-text">API</span>
                    <span class="snav-arrow">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
                    </span>
                </NavLink>
            </div>

            <div class="settings-nav-group">
                <div class="settings-nav-group-title">
                    <span class="settings-nav-group-line"></span>
                    <span>Мониторинг</span>
                    <span class="settings-nav-group-line"></span>
                </div>
                <NavLink class="settings-nav-item" href="/settings/sessions">
                    <span class="snav-icon snav-icon--emerald">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 013 3L7 19l-4 1 1-4L16.5 3.5z"/>
                        </svg>
                    </span>
                    <span class="snav-text">Сессии</span>
                    <span class="snav-arrow">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
                    </span>
                </NavLink>
                <NavLink class="settings-nav-item" href="/settings/analytics">
                    <span class="snav-icon snav-icon--violet">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/>
                        </svg>
                    </span>
                    <span class="snav-text">Аналитика</span>
                    <span class="snav-arrow">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
                    </span>
                </NavLink>
            </div>
        </nav>
    </aside>
    <main class="settings-content">
        @Body
    </main>
</div>
