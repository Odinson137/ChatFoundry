@page "/settings/sessions"
@layout SettingsLayout
@using BlazorClient.Models.DTO
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

@inject BlazorClient.Interfaces.IWorkflowApiClient ApiClient
@inject NavigationManager Navigation

<PageTitle>Настройки — Сессии — ChatFoundry</PageTitle>

<div class="settings-page-header">
    <div>
        <h1 class="settings-page-title">Сессии</h1>
        <p class="settings-page-subtitle">Просмотр взаимодействий пользователей с ботами</p>
    </div>
    <div class="sess-filters">
        <select class="settings-select" style="width: auto; min-width: 160px;" @bind="StatusFilter" @bind:after="OnFilterChanged">
            <option value="">Все статусы</option>
            <option value="ACTIVE">Активные</option>
            <option value="COMPLETED">Завершённые</option>
            <option value="FAILED">Ошибка</option>
            <option value="CANCELLED">Отменённые</option>
        </select>
        <button class="settings-icon-btn" @onclick="OnRefreshClick" title="Обновить">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 11-2.12-9.36L23 10"/></svg>
        </button>
    </div>
</div>

@if (_isLoading)
{
    <div class="settings-spinner-wrap">
        <div class="settings-spinner"></div>
    </div>
}
else if (!string.IsNullOrEmpty(_error))
{
    <div class="settings-alert settings-alert-danger">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
        <span>@_error</span>
        <button style="margin-left:auto;background:none;border:none;color:inherit;cursor:pointer;opacity:0.6;" @onclick="() => _error = null">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
    </div>
}
else if (!_sessions.Any())
{
    <div class="settings-empty-state">
        <div class="settings-empty-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#6366f1" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 013 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
        </div>
        <div class="settings-empty-title">Нет сессий</div>
        <div class="settings-empty-desc">Сессии появятся, когда пользователи начнут взаимодействовать с ботами.</div>
    </div>
}
else
{
    <div class="settings-card">
        <table class="settings-table">
            <thead>
            <tr>
                <th>Клиент</th>
                <th>Бот</th>
                <th>Канал</th>
                <th>Статус</th>
                <th>Шагов</th>
                <th>Создана</th>
                <th style="text-align: right;"></th>
            </tr>
            </thead>
            <tbody>
            @foreach (var s in _sessions)
            {
                <tr>
                    <td>
                        <code class="sess-client-id">@TruncateClientId(s.ClientId)</code>
                    </td>
                    <td>
                        <div class="sess-bot-info">
                            <span class="sess-bot-name">@(s.Workflow?.Bot?.Name ?? "—")</span>
                            <span class="sess-bot-version">v@(s.Workflow?.Version ?? 0)</span>
                        </div>
                    </td>
                    <td>
                        <span class="settings-badge settings-badge-neutral">@FormatChannel(s.Channel)</span>
                    </td>
                    <td>
                        <span class="settings-badge @StatusBadgeClass(s.Status)">@StatusLabel(s.Status)</span>
                    </td>
                    <td>
                        <span class="sess-step-count">@(s.Actions?.Count ?? 0)</span>
                    </td>
                    <td>
                        <div class="sess-date-cell">
                            <span>@s.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</span>
                            @if (s.CompletedAt.HasValue)
                            {
                                <span class="sess-date-completed">→ @s.CompletedAt.Value.ToLocalTime().ToString("HH:mm")</span>
                            }
                        </div>
                    </td>
                    <td style="text-align: right;">
                        <button class="settings-btn-secondary" style="padding: 6px 12px; font-size: 0.8rem;" @onclick="() => OpenReplay(s.Id)">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polygon points="10 8 16 12 10 16 10 8"/></svg>
                            Путь
                        </button>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>

    @if (_totalCount > 0)
    {
        <div class="sess-pagination">
            <div class="sess-pagination-info">
                <span class="sess-pagination-muted">Показано @_sessions.Count из @_totalCount</span>
            </div>
            <div class="sess-pagination-controls">
                <label class="sess-pagination-muted">На странице:</label>
                <select class="sess-page-size" @bind="_pageSize" @bind:after="OnPageSizeChanged">
                    <option value="10">10</option>
                    <option value="25">25</option>
                    <option value="50">50</option>
                </select>
                <button class="sess-btn-page" disabled="@(!_hasPreviousPage)" @onclick="GoToPreviousPage" title="Назад">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
                </button>
                <button class="sess-btn-page" disabled="@(!_hasNextPage)" @onclick="GoToNextPage" title="Вперёд">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
                </button>
            </div>
        </div>
    }
}

@code {
    private List<SessionDto> _sessions = [];
    private bool _isLoading = true;
    private string? _error;
    private string StatusFilter { get; set; } = "";

    private int _pageSize = 25;
    private string? _endCursor;
    private readonly List<string> _cursorStack = [];
    private bool _hasNextPage;
    private bool _hasPreviousPage;
    private int _totalCount;

    protected override async Task OnInitializedAsync()
    {
        await LoadSessions();
    }

    private async Task LoadSessions()
    {
        _isLoading = true;
        _error = null;
        StateHasChanged();

        try
        {
            var filter = string.IsNullOrEmpty(StatusFilter) ? null : StatusFilter;
            var result = await ApiClient.GetSessionsPagedAsync(_pageSize, _endCursor, filter);
            _sessions = result.Items;
            _totalCount = result.TotalCount;
            _hasNextPage = result.HasNextPage;
            _hasPreviousPage = _cursorStack.Count > 0;
            _endCursor = result.EndCursor;
        }
        catch (Exception ex)
        {
            _error = $"Не удалось загрузить сессии: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task OnFilterChanged()
    {
        ResetPagination();
        await LoadSessions();
    }

    private async Task OnRefreshClick()
    {
        ResetPagination();
        await LoadSessions();
    }

    private async Task OnPageSizeChanged()
    {
        ResetPagination();
        await LoadSessions();
    }

    private async Task GoToNextPage()
    {
        if (_endCursor != null)
            _cursorStack.Add(_endCursor);
        await LoadSessions();
    }

    private async Task GoToPreviousPage()
    {
        if (_cursorStack.Count > 0)
            _cursorStack.RemoveAt(_cursorStack.Count - 1);
        _endCursor = _cursorStack.Count > 0 ? _cursorStack[^1] : null;
        await LoadSessions();
    }

    private void ResetPagination()
    {
        _endCursor = null;
        _cursorStack.Clear();
    }

    private void OpenReplay(Guid sessionId)
    {
        Navigation.NavigateTo($"/settings/sessions/{sessionId}");
    }

    private static string TruncateClientId(string clientId)
    {
        if (string.IsNullOrEmpty(clientId)) return "—";
        return clientId.Length > 16 ? clientId[..16] + "..." : clientId;
    }

    private static string FormatChannel(string? channel)
    {
        return channel?.ToUpperInvariant() switch
        {
            "TELEGRAM" => "Telegram",
            "WEB" => "Web",
            "WHATSAPP" => "WhatsApp",
            "API" => "API",
            "EMAIL" => "Email",
            _ => channel ?? "—"
        };
    }

    private static string StatusBadgeClass(string? status) => status?.ToUpperInvariant() switch
    {
        "ACTIVE" => "settings-badge-primary",
        "COMPLETED" => "settings-badge-success",
        "FAILED" => "settings-badge-danger",
        "CANCELLED" => "settings-badge-warning",
        _ => "settings-badge-neutral"
    };

    private static string StatusLabel(string? status) => status?.ToUpperInvariant() switch
    {
        "ACTIVE" => "Активна",
        "COMPLETED" => "Завершена",
        "FAILED" => "Ошибка",
        "CANCELLED" => "Отменена",
        _ => status ?? "—"
    };
}
