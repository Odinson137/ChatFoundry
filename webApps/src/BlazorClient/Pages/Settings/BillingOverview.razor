@page "/settings/billing"
@layout SettingsLayout
@using Microsoft.AspNetCore.Authorization
@using BlazorClient.Models.DTO

@attribute [Authorize]

@inject IBillingApiClient Billing
@inject NavigationManager Nav

<PageTitle>Настройки — Биллинг — ChatFoundry</PageTitle>

<div class="settings-page-header">
    <div>
        <h1 class="settings-page-title">Биллинг</h1>
        <p class="settings-page-subtitle">Подписка, баланс и использование ресурсов</p>
    </div>
</div>

@if (loadError != null)
{
    <div class="settings-alert settings-alert-danger">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
        <span>@loadError</span>
    </div>
}
else if (isLoading)
{
    <div class="settings-spinner-wrap">
        <div class="settings-spinner"></div>
    </div>
}
else if (_overview == null)
{
    <div class="settings-empty-state">
        <div class="settings-empty-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#6366f1" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"/></svg>
        </div>
        <div class="settings-empty-title">Данные биллинга недоступны</div>
        <div class="settings-empty-desc">Не удалось загрузить информацию о подписке. Попробуйте позже.</div>
    </div>
}
else
{
    <!-- Stat cards: plan, balance, period, status -->
    <div class="settings-stat-grid">
        <div class="settings-stat-card billing-plan-card">
            <div class="billing-stat-header">
                <div class="settings-stat-icon" style="background: linear-gradient(135deg, #fef3c7, #fde68a);">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#f59e0b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
                </div>
                <div class="settings-stat-label">Текущий план</div>
            </div>
            <div class="settings-stat-value billing-plan-name">@PlanDisplayName(_overview.PlanSlug)</div>
        </div>
        <div class="settings-stat-card">
            <div class="billing-stat-header">
                <div class="settings-stat-icon" style="background: #ecfdf5;">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"/></svg>
                </div>
                <div class="settings-stat-label">Баланс</div>
            </div>
            <div class="settings-stat-value">@_overview.Balance.ToString("F2") <span class="billing-currency">@_overview.Currency</span></div>
        </div>
        <div class="settings-stat-card">
            <div class="billing-stat-header">
                <div class="settings-stat-icon" style="background: #eef2ff;">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#6366f1" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                </div>
                <div class="settings-stat-label">Период до</div>
            </div>
            <div class="settings-stat-value billing-date-value">@_overview.CurrentPeriodEnd.ToString("dd MMM yyyy")</div>
        </div>
        <div class="settings-stat-card">
            <div class="billing-stat-header">
                <div class="settings-stat-icon" style="background: #f5f3ff;">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#8b5cf6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                </div>
                <div class="settings-stat-label">Статус</div>
            </div>
            <div class="settings-stat-value">
                <span class="settings-badge @StatusBadgeClass(_overview.SubscriptionStatus)">@StatusDisplay(_overview.SubscriptionStatus)</span>
            </div>
        </div>
    </div>

    <!-- Usage limits -->
    <div class="settings-card billing-usage-card">
        <div class="settings-card-body">
            <h3 class="billing-section-title">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#6366f1" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
                Лимиты использования
            </h3>
            <div class="billing-limits-grid">
                <div class="billing-limit-item">
                    <div class="billing-limit-header">
                        <span class="billing-limit-label">Клиенты</span>
                        <span class="billing-limit-value">@FormatCount(_overview.MaxClients)</span>
                    </div>
                </div>
                <div class="billing-limit-item">
                    <div class="billing-limit-header">
                        <span class="billing-limit-label">Боты</span>
                        <span class="billing-limit-value">@FormatCount(_overview.MaxBots)</span>
                    </div>
                </div>
                <div class="billing-limit-item">
                    <div class="billing-limit-header">
                        <span class="billing-limit-label">Участники команды</span>
                        <span class="billing-limit-value">@_overview.MaxTeamMembers</span>
                    </div>
                </div>
                <div class="billing-limit-item">
                    <div class="billing-limit-header">
                        <span class="billing-limit-label">AI в workflow</span>
                        <span class="billing-limit-value">@_overview.AiExecutionsUsed / @FormatCount(_overview.MaxAiExecutions)</span>
                    </div>
                    <div class="billing-progress">
                        <div class="billing-progress-bar" style="width: @UsagePercent(_overview.AiExecutionsUsed, _overview.MaxAiExecutions)%; background: @UsageColor(_overview.AiExecutionsUsed, _overview.MaxAiExecutions);"></div>
                    </div>
                </div>
                <div class="billing-limit-item">
                    <div class="billing-limit-header">
                        <span class="billing-limit-label">AI конструктор</span>
                        <span class="billing-limit-value">@_overview.AiBuilderUsed / @FormatCount(_overview.MaxAiBuilder)</span>
                    </div>
                    <div class="billing-progress">
                        <div class="billing-progress-bar" style="width: @UsagePercent(_overview.AiBuilderUsed, _overview.MaxAiBuilder)%; background: @UsageColor(_overview.AiBuilderUsed, _overview.MaxAiBuilder);"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Features -->
    <div class="settings-card" style="margin-top: 1rem;">
        <div class="settings-card-body">
            <h3 class="billing-section-title">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#6366f1" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                Возможности плана
            </h3>
            <div class="billing-features-grid">
                <div class="billing-feature @(_overview.HasAnalytics ? "billing-feature-on" : "billing-feature-off")">
                    <span class="billing-feature-icon">
                        @if (_overview.HasAnalytics)
                        {
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                        }
                        else
                        {
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                        }
                    </span>
                    <span>Аналитика</span>
                </div>
                <div class="billing-feature @(_overview.HasApiAccess ? "billing-feature-on" : "billing-feature-off")">
                    <span class="billing-feature-icon">
                        @if (_overview.HasApiAccess)
                        {
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                        }
                        else
                        {
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                        }
                    </span>
                    <span>API доступ</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick actions -->
    <div class="billing-actions">
        <NavLink class="settings-btn-primary" href="/settings/billing/plans">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
            Сменить план
        </NavLink>
        <NavLink class="settings-btn-secondary" href="/settings/billing/top-up">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"/></svg>
            Пополнить баланс
        </NavLink>
        <NavLink class="settings-btn-secondary" href="/settings/billing/transactions">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
            Транзакции
        </NavLink>
        <NavLink class="settings-btn-secondary" href="/settings/billing/usage">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
            Использование
        </NavLink>
    </div>
}

@code {
    private BillingOverviewDto? _overview;
    private bool isLoading = true;
    private string? loadError;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _overview = await Billing.GetBillingOverviewAsync();
        }
        catch (Exception ex)
        {
            loadError = $"Не удалось загрузить данные биллинга: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private static string PlanDisplayName(string slug) => slug.ToUpperInvariant() switch
    {
        "FREE" => "Free",
        "STARTER" => "Starter",
        "PRO" => "Pro",
        "BUSINESS" => "Business",
        "ENTERPRISE" => "Enterprise",
        _ => slug
    };

    private static string StatusBadgeClass(string status) => status.ToUpperInvariant() switch
    {
        "ACTIVE" => "settings-badge-success",
        "TRIALING" => "settings-badge-primary",
        "PAST_DUE" => "settings-badge-warning",
        "CANCELLED" or "EXPIRED" => "settings-badge-danger",
        _ => "settings-badge-neutral"
    };

    private static string StatusDisplay(string status) => status.ToUpperInvariant() switch
    {
        "ACTIVE" => "Активен",
        "TRIALING" => "Пробный",
        "PAST_DUE" => "Просрочен",
        "CANCELLED" => "Отменён",
        "EXPIRED" => "Истёк",
        _ => status
    };

    private static string FormatCount(int max) => max >= int.MaxValue - 1000 ? "∞" : max.ToString();

    private static string UsagePercent(int used, int max) =>
        max >= int.MaxValue - 1000 ? "0" : Math.Min(100, (int)((double)used / max * 100)).ToString();

    private static string UsageColor(int used, int max) =>
        max >= int.MaxValue - 1000 ? "#6366f1" :
        (double)used / max > 0.9 ? "#ef4444" :
        (double)used / max > 0.7 ? "#f59e0b" : "#6366f1";
}
