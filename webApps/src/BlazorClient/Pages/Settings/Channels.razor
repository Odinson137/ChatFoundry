@page "/settings/channels"
@page "/channels"
@layout SettingsLayout
@using BlazorClient.Models.DTO
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

@inject BlazorClient.Interfaces.IWorkflowApiClient ApiClient
@inject IJSRuntime JsRuntime

<PageTitle>Настройки — Каналы — ChatFoundry</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Каналы</h1>
    <button class="btn btn-primary" @onclick="OpenCreateModal">
        <span class="oi oi-plus"></span> Добавить канал
    </button>
</div>

@if (isLoading)
{
    <div class="d-flex justify-content-center">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Загрузка...</span>
        </div>
    </div>
}
else if (!string.IsNullOrEmpty(error))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @error
        <button type="button" class="btn-close" @onclick="() => error = null"></button>
    </div>
}
else
{
    @if (!channels.Any())
    {
        <div class="alert alert-info">Каналы не найдены. Добавьте первый канал (например, Telegram).</div>
    }
    else
    {
        <table class="table table-hover align-middle">
            <thead class="table-light">
            <tr>
                <th>Имя</th>
                <th>Тип</th>
                <th>Токен</th>
                <th class="text-end">Действия</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var ch in channels)
            {
                <tr>
                    <td class="fw-bold">@ch.Name</td>
                    <td>@ChannelTypeDisplayName(ch.ChannelType)</td>
                    <td><code class="text-muted">@ch.MaskedToken</code></td>
                    <td class="text-end">
                        <button class="btn btn-sm btn-outline-secondary me-2" @onclick="() => RefreshWebhook(ch)" disabled="@(refreshingChannelId == ch.Id)" title="Актуализировать webhook">
                            @if (refreshingChannelId == ch.Id)
                            {
                                <span class="spinner-border spinner-border-sm"></span>
                            }
                            else
                            {
                                <span class="oi oi-reload"></span>
                            }
                        </button>
                        <button class="btn btn-sm btn-outline-primary me-2" @onclick="() => OpenEditModal(ch)">
                            <span class="oi oi-pencil"></span>
                        </button>
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteChannel(ch)">
                            <span class="oi oi-trash"></span>
                        </button>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }
}

@* Модалка создания/редактирования канала *@
@if (showModal)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(isEditMode ? "Редактировать канал" : "Новый канал")</h5>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Имя</label>
                        <input type="text" class="form-control" @bind="currentName" placeholder="Мой Telegram" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Токен</label>
                        <input type="text" class="form-control" @bind="currentToken" placeholder="@(isEditMode ? "Оставьте пустым, чтобы не менять" : "Токен бота от @BotFather")" />
                        @if (isEditMode)
                        {
                            <div class="form-text">Оставьте поле пустым, чтобы не менять токен.</div>
                        }
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Тип канала</label>
                        <select class="form-select" @bind="currentChannelType">
                            <option value="TELEGRAM">Telegram</option>
                            <option value="WEB">Web</option>
                            <option value="WHATSAPP">WhatsApp</option>
                            <option value="API">Api</option>
                            <option value="EMAIL">Email</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseModal">Отмена</button>
                    <button type="button" class="btn btn-primary" @onclick="SaveChannel" disabled="@(isSaving || string.IsNullOrWhiteSpace(currentName) || (!isEditMode && string.IsNullOrWhiteSpace(currentToken)))">
                        @if (isSaving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                        Сохранить
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<ChannelDto> channels = new();
    private bool isLoading = true;
    private bool isSaving;
    private string? error;

    private bool showModal;
    private bool isEditMode;
    private Guid? editChannelId;
    private string currentName = "";
    private string currentToken = "";
    private string currentChannelType = "TELEGRAM";
    private Guid? refreshingChannelId;

    protected override async Task OnInitializedAsync()
    {
        await LoadChannels();
    }

    private async Task LoadChannels()
    {
        isLoading = true;
        error = null;
        try
        {
            channels = await ApiClient.GetChannelsAsync();
        }
        catch (Exception ex)
        {
            error = $"Ошибка загрузки: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SaveChannel()
    {
        if (string.IsNullOrWhiteSpace(currentName))
            return;
        if (!isEditMode && string.IsNullOrWhiteSpace(currentToken))
            return;

        isSaving = true;
        error = null;
        try
        {
            if (isEditMode && editChannelId.HasValue)
            {
                await ApiClient.UpdateChannelAsync(editChannelId.Value, currentName.Trim(), string.IsNullOrWhiteSpace(currentToken) ? null : currentToken.Trim(), currentChannelType);
            }
            else
            {
                await ApiClient.AddChannelAsync(currentName.Trim(), currentToken.Trim(), currentChannelType);
            }
            CloseModal();
            await LoadChannels();
        }
        catch (Exception ex)
        {
            error = $"Ошибка сохранения: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task RefreshWebhook(ChannelDto ch)
    {
        refreshingChannelId = ch.Id;
        error = null;
        try
        {
            await ApiClient.RefreshChannelWebhookAsync(ch.Id);
        }
        catch (Exception ex)
        {
            error = $"Хук: {ex.Message}";
        }
        finally
        {
            refreshingChannelId = null;
        }
    }

    private async Task DeleteChannel(ChannelDto ch)
    {
        if (!await JsRuntime.InvokeAsync<bool>("confirm", $"Удалить канал «{ch.Name}»?"))
            return;

        error = null;
        try
        {
            await ApiClient.DeleteChannelAsync(ch.Id);
            await LoadChannels();
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }

    private void OpenCreateModal()
    {
        editChannelId = null;
        isEditMode = false;
        currentName = "";
        currentToken = "";
        currentChannelType = "TELEGRAM";
        showModal = true;
    }

    private void OpenEditModal(ChannelDto ch)
    {
        editChannelId = ch.Id;
        isEditMode = true;
        currentName = ch.Name;
        currentToken = "";
        currentChannelType = ch.ChannelType ?? "TELEGRAM";
        showModal = true;
    }

    private void CloseModal()
    {
        showModal = false;
        error = null;
    }

    private static string ChannelTypeDisplayName(string? channelType)
    {
        return channelType switch
        {
            "TELEGRAM" => "Telegram",
            "WEB" => "Web",
            "WHATSAPP" => "WhatsApp",
            "API" => "Api",
            "EMAIL" => "Email",
            _ => channelType ?? "—"
        };
    }
}
