@page "/bots"
@using BlazorClient.Models.DTO
@using Microsoft.AspNetCore.Authorization

@attribute [Authorize]

@inject BlazorClient.Interfaces.IWorkflowApiClient ApiClient
@inject IJSRuntime JsRuntime

<PageTitle>Управление ботами</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Управление ботами</h1>
    <button class="btn btn-primary" @onclick="OpenCreateModal">
        <span class="oi oi-plus"></span> Добавить бота
    </button>
</div>

@if (isLoading)
{
    <div class="d-flex justify-content-center">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Загрузка...</span>
        </div>
    </div>
}
else if (!string.IsNullOrEmpty(error))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @error
        <button type="button" class="btn-close" @onclick="() => error = null"></button>
    </div>
}
else
{
    @if (!bots.Any())
    {
        <div class="alert alert-info">Боты не найдены. Создайте первого бота!</div>
    }
    else
    {
        <table class="table table-hover align-middle">
            <thead class="table-light">
            <tr>
                <th>Имя</th>
                <th>Токен</th>
                <th>Активный Workflow</th>
                <th>Создан</th>
                <th class="text-end">Действия</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var bot in bots)
            {
                <tr>
                    <td class="fw-bold">@bot.Name</td>
                    <td>
                        <code class="text-muted">@(bot.Token.Length > 10 ? bot.Token.Substring(0, 10) + "..." : bot.Token)</code>
                    </td>
                    <td>
                        @{
                            var activeWorkflow = bot.Workflows?.FirstOrDefault(w => w.IsActiveBotWorkflow);
                            if (activeWorkflow != null)
                            {
                                <span class="badge bg-success">v@(activeWorkflow.Version)</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Нет</span>
                            }
                        }
                    </td>
                    <td>@bot.CreatedAt.ToLocalTime().ToString("g")</td>
                    <td class="text-end">
                        <a href="@($"bots/{bot.Id}")" class="btn btn-sm btn-primary me-2" title="Открыть воркфлоу">
                            <span class="oi oi-eye"></span> Открыть
                        </a>
                        <button class="btn btn-sm btn-outline-primary me-2" @onclick="() => OpenEditModal(bot)">
                            <span class="oi oi-pencil"></span>
                        </button>
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteBot(bot)">
                            <span class="oi oi-trash"></span>
                        </button>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }
}

@* --- Модалька --- *@
@if (showModal)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(isEditMode ? "Редактировать бота" : "Новый бот")</h5>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Имя бота</label>
                        <input type="text" class="form-control" @bind="currentBotModel.Name" placeholder="My Super Bot" />
                    </div>
                    @if (!isEditMode)
                    {
                        <div class="mb-3">
                            <label class="form-label">Токен (Telegram/Other)</label>
                            <input type="text" class="form-control" @bind="currentBotModel.Token" />
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseModal">Отмена</button>
                    <button type="button" class="btn btn-primary" @onclick="SaveBot" disabled="@isSaving">
                        @if (isSaving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                        Сохранить
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<BotDto> bots = new();
    private bool isLoading = true;
    private bool isSaving;
    private string? error;

    private bool showModal;
    private bool isEditMode;
    private BotInputModel currentBotModel = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadBots();
    }

    private async Task LoadBots()
    {
        isLoading = true;
        error = null;
        try
        {
            bots = await ApiClient.GetBotsAsync();
        }
        catch (Exception ex)
        {
            error = $"Ошибка загрузки: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SaveBot()
    {
        if (string.IsNullOrWhiteSpace(currentBotModel.Name)
            || (!isEditMode && string.IsNullOrWhiteSpace(currentBotModel.Token)))
        {
            return;
        }

        isSaving = true;
        try
        {
            if (isEditMode)
                await ApiClient.UpdateBotAsync(currentBotModel.Id, currentBotModel.Name);
            else
                await ApiClient.AddBotAsync(currentBotModel.Name, currentBotModel.Token);

            CloseModal();
            await LoadBots();
        }
        catch (Exception ex)
        {
            error = $"Ошибка сохранения: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task DeleteBot(BotDto bot)
    {
        if (!await JsRuntime.InvokeAsync<bool>("confirm", $"Вы уверены, что хотите удалить бота '{bot.Name}'?"))
            return;

        try
        {
            await ApiClient.DeleteBotAsync(bot.Id);
            await LoadBots();
        }
        catch (Exception ex)
        {
            error = $"Не удалось удалить: {ex.Message}";
        }
    }

    private void OpenCreateModal()
    {
        currentBotModel = new BotInputModel();
        isEditMode = false;
        showModal = true;
    }

    private void OpenEditModal(BotDto bot)
    {
        currentBotModel = new BotInputModel
        {
            Id = bot.Id,
            Name = bot.Name,
            Token = bot.Token
        };
        isEditMode = true;
        showModal = true;
    }

    private void CloseModal()
    {
        showModal = false;
        error = null;
    }

    private class BotInputModel
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = "";
        public string Token { get; set; } = "";
    }
}
