@page "/bots"
@using BlazorClient.Models.DTO
@using Microsoft.AspNetCore.Authorization

@attribute [Authorize]

@inject BlazorClient.Interfaces.IWorkflowApiClient ApiClient
@inject IJSRuntime JsRuntime

<PageTitle>Управление ботами</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Управление ботами</h1>
    <button class="btn btn-primary" @onclick="OnOpenCreateModal">
        <span class="oi oi-plus"></span> Добавить бота
    </button>
</div>

@if (isLoading)
{
    <div class="d-flex justify-content-center">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Загрузка...</span>
        </div>
    </div>
}
else if (!string.IsNullOrEmpty(error))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @error
        <button type="button" class="btn-close" @onclick="() => error = null"></button>
    </div>
}
else
{
    @if (!bots.Any())
    {
        <div class="alert alert-info">Боты не найдены. Создайте первого бота!</div>
    }
    else
    {
        <table class="table table-hover align-middle">
            <thead class="table-light">
            <tr>
                <th>Имя</th>
                <th>Каналы</th>
                <th>Активный Workflow</th>
                <th>Создан</th>
                <th class="text-end">Действия</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var bot in bots)
            {
                <tr>
                    <td class="fw-bold">@bot.Name</td>
                    <td>
                        @{
                            var channelNames = bot.BotChannels?
                                .Where(bc => bc.Channel != null)
                                .Select(bc => bc.Channel!.Name)
                                .ToList() ?? new List<string>();
                            if (channelNames.Count == 0)
                            {
                                <span class="text-muted">—</span>
                            }
                            else if (channelNames.Count <= 2)
                            {
                                @string.Join(", ", channelNames)
                            }
                            else
                            {
                                <span title="@string.Join(", ", channelNames)">@channelNames.Count каналов</span>
                            }
                        }
                    </td>
                    <td>
                        @{
                            var activeWorkflow = bot.Workflows?.FirstOrDefault(w => w.IsActiveBotWorkflow);
                            if (activeWorkflow != null)
                            {
                                <span class="badge bg-success">v@(activeWorkflow.Version)</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Нет</span>
                            }
                        }
                    </td>
                    <td>@bot.CreatedAt.ToLocalTime().ToString("g")</td>
                    <td class="text-end">
                        <a href="@($"bots/{bot.Id}")" class="btn btn-sm btn-primary me-2" title="Открыть воркфлоу">
                            <span class="oi oi-eye"></span> Открыть
                        </a>
                        <button class="btn btn-sm btn-outline-primary me-2" @onclick="() => OnOpenEditModal(bot)">
                            <span class="oi oi-pencil"></span>
                        </button>
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteBot(bot)">
                            <span class="oi oi-trash"></span>
                        </button>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }
}

@* --- Модалька --- *@
@if (showModal)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(isEditMode ? "Редактировать бота" : "Новый бот")</h5>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Имя бота</label>
                        <input type="text" class="form-control" @bind="currentBotModel.Name" placeholder="My Super Bot" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Каналы</label>
                        @if (availableChannels.Count == 0)
                        {
                            <p class="text-muted small mb-0">Нет доступных каналов. Создайте каналы на странице <a href="/channels">Каналы</a>.</p>
                        }
                        else
                        {
                            <div class="border rounded p-2" style="max-height: 180px; overflow-y: auto;">
                                @foreach (var ch in availableChannels)
                                {
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="ch_@ch.Id" checked="@currentBotModel.SelectedChannelIds.Contains(ch.Id)" @onchange="() => ToggleChannel(ch.Id)" />
                                        <label class="form-check-label" for="ch_@ch.Id">@ch.Name <span class="text-muted small">(@ch.ChannelType)</span></label>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseModal">Отмена</button>
                    <button type="button" class="btn btn-primary" @onclick="SaveBot" disabled="@(isSaving || string.IsNullOrWhiteSpace(currentBotModel.Name))">
                        @if (isSaving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                        Сохранить
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<BotDto> bots = new();
    private List<ChannelDto> availableChannels = new();
    private bool isLoading = true;
    private bool isSaving;
    private string? error;

    private bool showModal;
    private bool isEditMode;
    private BotInputModel currentBotModel = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadBots();
    }

    private async Task LoadBots()
    {
        isLoading = true;
        error = null;
        try
        {
            bots = await ApiClient.GetBotsAsync();
        }
        catch (Exception ex)
        {
            error = $"Ошибка загрузки: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadChannelsForModal()
    {
        try
        {
            availableChannels = await ApiClient.GetChannelsAsync();
        }
        catch
        {
            availableChannels = new List<ChannelDto>();
        }
    }

    private void ToggleChannel(Guid channelId)
    {
        if (currentBotModel.SelectedChannelIds.Contains(channelId))
            currentBotModel.SelectedChannelIds.Remove(channelId);
        else
            currentBotModel.SelectedChannelIds.Add(channelId);
        StateHasChanged();
    }

    private async Task SaveBot()
    {
        if (string.IsNullOrWhiteSpace(currentBotModel.Name))
            return;

        isSaving = true;
        try
        {
            var channelIds = currentBotModel.SelectedChannelIds.ToList();
            if (isEditMode)
                await ApiClient.UpdateBotAsync(currentBotModel.Id, currentBotModel.Name.Trim(), channelIds);
            else
                await ApiClient.AddBotAsync(currentBotModel.Name.Trim(), channelIds);

            CloseModal();
            await LoadBots();
        }
        catch (Exception ex)
        {
            error = $"Ошибка сохранения: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task DeleteBot(BotDto bot)
    {
        if (!await JsRuntime.InvokeAsync<bool>("confirm", $"Вы уверены, что хотите удалить бота '{bot.Name}'?"))
            return;

        try
        {
            await ApiClient.DeleteBotAsync(bot.Id);
            await LoadBots();
        }
        catch (Exception ex)
        {
            error = $"Не удалось удалить: {ex.Message}";
        }
    }

    private async Task OnOpenCreateModal()
    {
        currentBotModel = new BotInputModel();
        isEditMode = false;
        showModal = true;
        await LoadChannelsForModal();
    }

    private async Task OnOpenEditModal(BotDto bot)
    {
        currentBotModel = new BotInputModel
        {
            Id = bot.Id,
            Name = bot.Name,
            SelectedChannelIds = bot.BotChannels?.Select(bc => bc.ChannelId).ToList() ?? new List<Guid>()
        };
        isEditMode = true;
        showModal = true;
        await LoadChannelsForModal();
    }

    private void CloseModal()
    {
        showModal = false;
        error = null;
    }

    private class BotInputModel
    {
        public Guid Id { get; set; }
        public string Name { get; set; } = "";
        public List<Guid> SelectedChannelIds { get; set; } = new();
    }
}
