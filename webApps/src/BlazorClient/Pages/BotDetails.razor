@page "/bots/{BotId:guid}"
@using Microsoft.AspNetCore.Authorization
@using System.Net.Http.Headers
@using System.Text.Json
@using Blazored.LocalStorage
@using BlazorClient.Configuration
@using BlazorClient.Models.DTO

@attribute [Authorize]

@inject HttpClient Http
@inject ILocalStorageService LocalStorage
@inject NavigationManager Navigation
@inject IJSRuntime JsRuntime

<PageTitle>@(bot?.Name ?? "Загрузка...")</PageTitle>

@if (isLoading)
{
    <div class="d-flex justify-content-center mt-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Загрузка...</span>
        </div>
    </div>
}
else if (!string.IsNullOrEmpty(error))
{
    <div class="alert alert-danger">
        <h4 class="alert-heading">Ошибка!</h4>
        <p>@error</p>
        <hr>
        <button class="btn btn-outline-danger" @onclick="LoadBotData">Попробовать снова</button>
        <a href="bots" class="btn btn-link">Вернуться к списку</a>
    </div>
}
else if (bot != null)
{
    /* --- ХЛЕБНЫЕ КРОШКИ И ЗАГОЛОВОК --- */
    <div class="mb-4">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="bots">Боты</a></li>
                <li class="breadcrumb-item active" aria-current="page">@bot.Name</li>
            </ol>
        </nav>
        
        <div class="d-flex justify-content-between align-items-start">
            <div>
                <h1>@bot.Name</h1>
                <p class="text-muted">ID: <small>@bot.Id</small></p>
            </div>
            <div>
                 <button class="btn btn-success" @onclick="CreateNewWorkflowVersion">
                    <span class="oi oi-plus"></span> Новый Workflow
                </button>
            </div>
        </div>
    </div>

    /* --- МИНИ-ПРОСМОТР (ИНФО-КАРТОЧКИ) --- */
    <div class="row mb-5">
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title text-primary"><span class="oi oi-key"></span> Токен доступа</h5>
                    <div class="input-group mb-2">
                        <input type="text" class="form-control" value="@bot.Token" readonly id="botTokenInput">
                        <button class="btn btn-outline-secondary" type="button" @onclick="CopyToken">
                            <span class="oi oi-clipboard"></span>
                        </button>
                    </div>
                    <small class="text-muted">Используйте этот токен для подключения Telegram Webhook.</small>
                </div>
            </div>
        </div>
        
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title text-info"><span class="oi oi-clock"></span> Статистика</h5>
                    <ul class="list-unstyled">
                        <li><strong>Создан:</strong> @bot.CreatedAt.ToLocalTime().ToString("g")</li>
                        <li><strong>Изменен:</strong> @bot.ModifiedAt.ToLocalTime().ToString("g")</li>
                        <li><strong>Версий Workflow:</strong> @(bot.Workflows?.Count ?? 0)</li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm h-100 bg-light">
                <div class="card-body d-flex flex-column justify-content-center align-items-center">
                    <h5 class="text-secondary">Активная версия</h5>
                    @{
                        var active = bot.Workflows?.FirstOrDefault(w => w.IsActiveBotWorkflow);
                    }
                    @if (active != null)
                    {
                        <h2 class="display-6 text-success">v@(active.Version)</h2>
                        <span class="badge bg-success">Работает</span>
                    }
                    else
                    {
                        <h2 class="display-6 text-muted">-</h2>
                        <span class="badge bg-warning text-dark">Не выбрана</span>
                    }
                </div>
            </div>
        </div>
    </div>

    /* --- СПИСОК WORKFLOWS --- */
    <h3 class="mb-3">История версий Workflow</h3>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                <tr>
                    <th style="width: 10%">Версия</th>
                    <th style="width: 20%">Статус</th>
                    <th>Дата создания</th>
                    <th>ID схемы</th>
                    <th class="text-end">Действия</th>
                </tr>
                </thead>
                <tbody>
                @if (bot.Workflows != null && bot.Workflows.Any())
                {
                    @foreach (var wf in bot.Workflows.OrderByDescending(w => w.Version))
                    {
                        <tr class="@(wf.IsActiveBotWorkflow ? "table-success" : "")">
                            <td><strong>v@wf.Version</strong></td>
                            <td>
                                @if (wf.IsActiveBotWorkflow)
                                {
                                    <span class="badge bg-success">Активен</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Архив</span>
                                }
                            </td>
                            <td>@wf.CreatedAt.ToLocalTime().ToString("g")</td>
                            <td><small class="text-muted">@wf.Id</small></td>
                            <td class="text-end">
                                @if (!wf.IsActiveBotWorkflow)
                                {
                                    <button class="btn btn-sm btn-outline-success me-2" @onclick="() => SetActiveWorkflow(wf.Id)" title="Сделать активным">
                                        <span class="oi oi-check"></span>
                                    </button>
                                }
                                <a href="designer/@wf.Id" class="btn btn-sm btn-primary">
                                    <span class="oi oi-pencil"></span> Открыть редактор
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center py-4 text-muted">
                            Нет созданных workflow. Нажмите "Новый Workflow" чтобы начать.
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    [Parameter]
    public Guid BotId { get; set; }

    private BotDto? bot;
    private bool isLoading = true;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        await LoadBotData();
    }

    private async Task LoadBotData()
    {
        isLoading = true;
        error = null;
        try
        {
            // Мы объявляем переменную $id в заголовке запроса
            // И используем её внутри where
            var query = @"
            query Bots($id: UUID!) {
                bots(where: { id: { eq: $id } }) {
                    id
                    name
                    token
                    createdAt
                    modifiedAt
                    workflows {
                        id
                        version
                        isActiveBotWorkflow
                        createdAt
                        nodesDefinition
                        edgesDefinition
                        layoutDefinition
                    }
                }
            }";

            // Передаем значение переменной отдельно. 
            // Библиотека сама подставит BotId вместо $id безопасно.
            var variables = new { id = BotId };
        
            var data = await ExecuteGraphQl<BotDataResponse>(query, variables);
        
            bot = data.Bots.FirstOrDefault();
        
            if (bot == null)
            {
                error = "Бот не найден или у вас нет прав на его просмотр.";
            }
        }
        catch (Exception ex)
        {
            error = $"Ошибка: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task CreateNewWorkflowVersion()
    {
        await JsRuntime.InvokeVoidAsync("alert", "Функционал создания новой версии еще не подключен");
    }

    private async Task SetActiveWorkflow(Guid workflowId)
    {
         await JsRuntime.InvokeVoidAsync("alert", $"Активация workflow {workflowId}...");
    }

    private async Task CopyToken()
    {
        if (bot != null)
        {
            await JsRuntime.InvokeVoidAsync("navigator.clipboard.writeText", bot.Token);
        }
    }

    // --- Helpers ---

    private async Task<T> ExecuteGraphQl<T>(string query, object? variables = null)
    {
        var token = await LocalStorage.GetItemAsync<string>("authToken");
        
        var request = new HttpRequestMessage(HttpMethod.Post, $"{ApiEndpoints.Api}/workflow/graphql");
        request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);
        
        var payload = new { query, variables };
        request.Content = JsonContent.Create(payload);

        var response = await Http.SendAsync(request);
        var jsonString = await response.Content.ReadAsStringAsync();

        if (!response.IsSuccessStatusCode)
        {
             throw new Exception($"Http Error: {response.StatusCode}");
        }

        var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
        var gqlResponse = JsonSerializer.Deserialize<GraphQLResponse<T>>(jsonString, options);

        return gqlResponse!.Data!;
    }

    public class BotDataResponse 
    { 
        public List<BotDto> Bots { get; set; } = new(); 
    }

}
