@page "/bots/{BotId:guid}"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

<PageTitle>@(_bot?.Name ?? "Загрузка...")</PageTitle>

<div class="container-fluid py-4">
    @if (_isLoading)
    {
        <div class="text-center mt-5">
            <div class="spinner-border text-primary"></div>
        </div>
    }
    else if (_error != null)
    {
        <div class="alert alert-danger shadow-sm">
            <h5 class="alert-heading">Ошибка запроса</h5>
            <p>@_error</p>
            <button class="btn btn-primary btn-sm" @onclick="LoadBotData">Повторить</button>
        </div>
    }
    else if (_bot != null)
    {
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="bots">Список ботов</a></li>
                <li class="breadcrumb-item active">@_bot.Name</li>
            </ol>
        </nav>

        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="h2 mb-0">@_bot.Name</h1>
                <span class="badge bg-light text-dark border">ID: @_bot.Id</span>
            </div>
            <button class="btn btn-success shadow-sm" @onclick="CreateNewWorkflow">
                <span class="oi oi-plus"></span> Создать версию
            </button>
        </div>

        <div class="row g-4 mb-5">
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body">
                        <label class="form-label fw-bold text-muted small uppercase">Telegram API Token</label>
                        <div class="input-group">
                            <input type="text" class="form-control bg-light border-0" value="@_bot.Token" readonly>
                            <button class="btn btn-outline-primary" @onclick="CopyToken">
                                <span class="oi oi-copywriting"></span>
                            </button>
                        </div>
                        <button class="btn btn-sm btn-outline-secondary mt-2 w-100" 
                                @onclick="RefreshWebhook" 
                                disabled="@_isRefreshingWebhook">
                            @if (_isRefreshingWebhook)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                            }
                            else if (_webhookRefreshed)
                            {
                                <span class="oi oi-check me-1"></span>
                            }
                            else
                            {
                                <span class="oi oi-reload me-1"></span>
                            }
                            @(_isRefreshingWebhook ? "Обновляется..." : _webhookRefreshed ? "Готово" : "Актуализировать хук")
                        </button>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body">
                        <label class="form-label fw-bold text-muted small uppercase">Статистика</label>
                        <div class="d-flex justify-content-between mb-1">
                            <span>Всего версий:</span>
                            <span class="fw-bold">@(_bot.Workflows?.Count ?? 0)</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span>Обновлен:</span>
                            <span class="fw-bold">@_bot.ModifiedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                @{ var active = _bot.Workflows?.FirstOrDefault(w => w.IsActiveBotWorkflow); }
                <div class="card h-100 border-0 shadow-sm @(active != null ? "bg-success text-white" : "bg-warning")">
                    <div class="card-body d-flex flex-column align-items-center justify-content-center">
                        <div class="small fw-bold uppercase opacity-75">Текущий статус</div>
                        <div class="h2 mb-0">@(active != null ? $"v{active.Version}" : "Остановлен")</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0">История версий Workflow</h5>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-4">Версия</th>
                            <th>Состояние</th>
                            <th>Дата создания</th>
                            <th class="text-end pe-4">Управление</th>
                        </tr>
                    </thead>

                    <tbody>
                    @foreach (var wf in _bot.Workflows.OrderByDescending(w => w.Version))
                    {
                        <tr class="@(wf.IsActiveBotWorkflow ? "table-active" : "")">
                            <td class="ps-4 fw-bold">v@wf.Version</td>
                            <td>
                                @if (wf.IsActiveBotWorkflow)
                                {
                                    <span class="badge rounded-pill bg-success">Активен</span>
                                }
                                else
                                {
                                    <span class="badge rounded-pill bg-light text-dark border">Архив</span>
                                }
                            </td>
                            <td>@wf.CreatedAt.ToLocalTime().ToString("g")</td>
                            <td class="text-end pe-4">
                                @if (!wf.IsActiveBotWorkflow)
                                {
                                    <button class="btn btn-sm btn-link text-success p-0 me-3" 
                                            @onclick="() => SetActive(wf.Id)">
                                        Активировать
                                    </button>
                    
                                    <button class="btn btn-sm btn-link text-danger p-0 me-3" 
                                            @onclick="() => DeleteWorkflow(wf.Id)">
                                        <span class="oi oi-trash"></span>
                                    </button>
                                }
                
                                <button class="btn btn-sm btn-primary" @onclick="() => NavigateToDesigner(wf.Id)">
                                    <span class="oi oi-pencil"></span> Редактор
                                </button>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
