@page "/designer/{WorkflowId:guid}"
@using Blazor.Diagrams.Components
@using Blazor.Diagrams.Components.Widgets
@using Blazor.Diagrams.Core.Models
@using System.Text.RegularExpressions
@using BlazorClient.Models.Diagram
@using Microsoft.AspNetCore.Components.Forms
@layout MainLayout

<PageTitle>Редактор Workflow</PageTitle>

<div class="designer-page-container">
    <!-- Левая панель с узлами -->
    <div class="designer-sidebar">
        <div class="sidebar-header">
            <h5>Узлы</h5>
        </div>
        <div class="sidebar-content">
            <div class="sidebar-section">
                <small>ЛОГИКА</small>
                <div class="node-grid">
                    <div class="node-tool" draggable="true" @ondragstart="e => OnDragStart(e, NodeType.Start)">
                        <span class="oi oi-media-play"></span> Старт
                    </div>
                    <div class="node-tool" draggable="true" @ondragstart="e => OnDragStart(e, NodeType.Condition)">
                        <span class="oi oi-fork"></span> Условие
                    </div>
                    <div class="node-tool" draggable="true" @ondragstart="e => OnDragStart(e, NodeType.Wait)">
                        <span class="oi oi-timer"></span> Ожидание
                    </div>
                    <div class="node-tool" draggable="true" @ondragstart="e => OnDragStart(e, NodeType.End)">
                        <span class="oi oi-media-stop"></span> Конец
                    </div>
                </div>
            </div>
            <div class="sidebar-section">
                <small>КОНТЕНТ</small>
                <div class="node-grid">
                    <div class="node-tool" draggable="true" @ondragstart="e => OnDragStart(e, NodeType.Message)">
                        <span class="oi oi-chat"></span> Сообщение
                    </div>
                    <div class="node-tool" draggable="true" @ondragstart="e => OnDragStart(e, NodeType.Ask)">
                        <span class="oi oi-question-mark"></span> Вопрос
                    </div>
                    <div class="node-tool" draggable="true" @ondragstart="e => OnDragStart(e, NodeType.Media)">
                        <span class="oi oi-image"></span> Медиа
                    </div>
                </div>
            </div>
            <div class="sidebar-section">
                <small>ИНТЕГРАЦИИ</small>
                <div class="node-grid">
                    <div class="node-tool" draggable="true" @ondragstart="e => OnDragStart(e, NodeType.HttpRequest)">
                        <span class="oi oi-cloud-download"></span> API Запрос
                    </div>
                    <div class="node-tool" draggable="true" @ondragstart="e => OnDragStart(e, NodeType.SetVariable)">
                        <span class="oi oi-list"></span> Переменная
                    </div>
                    <div class="node-tool" draggable="true" @ondragstart="e => OnDragStart(e, NodeType.AIFilter)">
                        <span class="oi oi-eye"></span> AI Фильтр
                    </div>
                    <div class="node-tool" draggable="true" @ondragstart="e => OnDragStart(e, NodeType.AIGenerate)">
                        <span class="oi oi-bolt"></span> AI Текст
                    </div>
                </div>
            </div>
        </div>
        <div class="sidebar-footer">
            <button class="btn btn-primary w-100" @onclick="SaveWorkflow">
                <span class="oi oi-circle-check"></span> Сохранить
            </button>
        </div>
    </div>

    <!-- Canvas -->
    <div class="canvas-wrapper @(IsVariablesPanelOpen ? "with-variables-panel" : "")" 
         @ondrop="OnDrop" 
         @ondragover="OnDragOver" 
         @ondragover:preventDefault="true">
        <CascadingValue Value="Diagram">
            <DiagramCanvas>
                <Widgets>
                    <GridWidget Size="25" Mode="GridMode.Point" BackgroundColor="#f9fafb"/>
                    <SelectionBoxWidget/>
                </Widgets>
            </DiagramCanvas>
        </CascadingValue>
    </div>

    <!-- Панель настроек узла (центр) -->
    @if (SelectedModel != null)
    {
        <div class="designer-settings-panel">
            <div class="panel-header">
                <h6>Настройки</h6>
                <button type="button" class="btn-close" @onclick="() => SelectedModel = null"></button>
            </div>
            <div class="panel-body">
                @if (SelectedModel is NodeModel node)
                {
                    <div class="mb-3">
                        <label class="form-label">Заголовок</label>
                        <input type="text" class="form-control" @bind-value="node.Title" @bind-value:event="oninput"/>
                    </div>

                    @if (node is WorkflowNodeModel { Data: MessageNodeData msgData })
                    {
                        <div class="mb-3">
                            <label class="form-label d-flex justify-content-between align-items-center">
                                <span>Текст сообщения</span>
                                <button type="button" class="btn btn-sm btn-outline-secondary" 
                                        @onclick="() => ShowVariablePicker(v => InsertVariable(msgData, nameof(msgData.Text), v))">
                                    <span class="oi oi-code"></span> {}
                                </button>
                            </label>
                            <textarea class="form-control font-monospace" 
                                      @bind="msgData.Text" 
                                      @oninput="OnWorkflowChanged"
                                      rows="4"></textarea>
                            <small class="form-text text-muted">
                                Используйте <code>{{variable_name}}</code> или <code>${{variable_name}}</code>
                            </small>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Сохранить результат в переменную</label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input type="text" 
                                       class="form-control font-monospace" 
                                       @bind="msgData.Variable" 
                                       @oninput="OnWorkflowChanged"
                                       placeholder="например, message_id"/>
                            </div>
                            <small class="form-text text-muted">
                                Имя переменной для сохранения ID сообщения. Не обязательно.
                            </small>
                        </div>
                    }

                    @if (node is WorkflowNodeModel { Data: AskNodeData askData })
                    {
                        <div class="mb-3">
                            <label class="form-label d-flex justify-content-between align-items-center">
                                <span>Текст вопроса</span>
                                <button type="button" class="btn btn-sm btn-outline-secondary" 
                                        @onclick="() => ShowVariablePicker(v => InsertVariable(askData, nameof(askData.Text), v))">
                                    <span class="oi oi-code"></span> {}
                                </button>
                            </label>
                            <textarea class="form-control font-monospace" 
                                      @bind="askData.Text" 
                                      @oninput="OnWorkflowChanged"
                                      rows="4"></textarea>
                            <small class="form-text text-muted">
                                Используйте <code>{{variable_name}}</code> или <code>${{variable_name}}</code>
                            </small>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Кнопки (отправляются под сообщением)</label>
                            @if (askData.Ui?.Buttons != null)
                            {
                                @foreach (var btn in askData.Ui.Buttons.ToList())
                                {
                                    <div class="input-group mb-2">
                                        <input type="text" class="form-control" placeholder="Текст на кнопке" @bind="btn.Text" @oninput="OnWorkflowChanged"/>
                                        <input type="text" class="form-control font-monospace" placeholder="Значение (в переменную)" @bind="btn.Value" @oninput="OnWorkflowChanged"/>
                                        <button type="button" class="btn btn-outline-danger" @onclick="() => RemoveAskButton(askData, btn)">
                                            <span class="oi oi-trash"></span>
                                        </button>
                                    </div>
                                }
                            }
                            <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => AddAskButton(askData)">
                                <span class="oi oi-plus"></span> Добавить кнопку
                            </button>
                            <small class="form-text text-muted d-block mt-1">
                                При нажатии пользователем в переменную попадёт «Значение». Если кнопок нет — ожидается любой ввод.
                            </small>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Сохранить результат в переменную</label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input type="text" 
                                       class="form-control font-monospace" 
                                       @bind="askData.Variable" 
                                       @oninput="OnWorkflowChanged"
                                       placeholder="например, user_response"/>
                            </div>
                            <small class="form-text text-muted">
                                Имя переменной для сохранения ответа. Не обязательно.
                            </small>
                        </div>
                    }
                    
                    @if (node is WorkflowNodeModel { Data: SetVariableNodeData varData })
                    {
                        <div class="mb-3">
                            <label class="form-label d-flex justify-content-between align-items-center">
                                <span>Имя переменной</span>
                                <button type="button" class="btn btn-sm btn-outline-secondary" 
                                        @onclick="() => ShowVariablePicker(v => varData.Variable = v)">
                                    <span class="oi oi-code"></span> Выбрать
                                </button>
                            </label>
                            <input type="text" 
                                   class="form-control font-monospace" 
                                   @bind="varData.Variable" 
                                   @oninput="OnWorkflowChanged"
                                   placeholder="$user_name или $client.name"/>
                            <small class="form-text text-muted">
                                Имя переменной должно начинаться с $
                            </small>
                        </div>
                        <div class="mb-3">
                            <label class="form-label d-flex justify-content-between align-items-center">
                                <span>Значение</span>
                                <button type="button" class="btn btn-sm btn-outline-secondary" 
                                        @onclick="() => ShowVariablePicker(v => InsertVariable(varData, nameof(varData.Value), v))">
                                    <span class="oi oi-code"></span> {}
                                </button>
                            </label>
                            <input type="text" 
                                   class="form-control font-monospace" 
                                   @bind="varData.Value" 
                                   @oninput="OnWorkflowChanged"
                                   placeholder="Значение или {{variable_name}}"/>
                            <small class="form-text text-muted">
                                Можно использовать переменные
                            </small>
                        </div>
                    }

                    @if (node is WorkflowNodeModel { Data: HttpRequestNodeData httpData })
                    {
                        <div class="mb-3">
                            <label class="form-label">Метод</label>
                            <select class="form-select" @bind="httpData.Method">
                                <option value="GET">GET</option>
                                <option value="POST">POST</option>
                                <option value="PUT">PUT</option>
                                <option value="DELETE">DELETE</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label d-flex justify-content-between align-items-center">
                                <span>URL</span>
                                <button type="button" class="btn btn-sm btn-outline-secondary" 
                                        @onclick="() => ShowVariablePicker(v => InsertVariable(httpData, nameof(httpData.Url), v))">
                                    <span class="oi oi-code"></span> {}
                                </button>
                            </label>
                            <input type="text" class="form-control font-monospace" @bind="httpData.Url" placeholder="https://api.example.com/data"/>
                        </div>

                        @if (httpData.Method == "POST" || httpData.Method == "PUT")
                        {
                            <div class="mb-3">
                                <label class="form-label d-flex justify-content-between align-items-center">
                                    <span>Тело запроса (Body)</span>
                                    <button type="button" class="btn btn-sm btn-outline-secondary" 
                                            @onclick="() => ShowVariablePicker(v => InsertVariable(httpData, nameof(httpData.Body), v))">
                                        <span class="oi oi-code"></span> {}
                                    </button>
                                </label>
                                <textarea class="form-control font-monospace" rows="5" @bind="httpData.Body" placeholder='{"key": "{{variable_name}}"}'></textarea>
                            </div>
                        }

                        <div class="mb-3">
                            <label class="form-label">Заголовки</label>
                            @foreach (var header in httpData.Headers.ToList())
                            {
                                <div class="input-group mb-2">
                                    <input type="text" class="form-control" placeholder="Header Name" value="@header.Key"
                                           @onchange="@(e => { var newKey = e.Value.ToString(); if (!string.IsNullOrWhiteSpace(newKey)) { httpData.Headers.Remove(header.Key); httpData.Headers[newKey] = header.Value; }})"/>
                                    <input type="text" class="form-control" placeholder="Header Value" @bind="httpData.Headers[header.Key]" />
                                    <button class="btn btn-outline-danger" @onclick="() => httpData.Headers.Remove(header.Key)">
                                        <span class="oi oi-trash"></span>
                                    </button>
                                </div>
                            }
                            <button class="btn btn-sm btn-outline-primary" @onclick="() => AddHeader(httpData)">
                                <span class="oi oi-plus"></span> Добавить заголовок
                            </button>
                        </div>
                        
                        <hr/>

                        <div class="mb-3">
                            <label class="form-label">Сохранить тело ответа в переменную</label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input type="text" class="form-control font-monospace" @bind="httpData.ResponseVariable" placeholder="api_response"/>
                            </div>
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label">Сохранить статус-код в переменную</label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input type="text" class="form-control font-monospace" @bind="httpData.StatusCodeVariable" placeholder="api_status_code"/>
                            </div>
                        </div>
                    }

                    @if (node is WorkflowNodeModel { Data: AIGenerateNodeData aiData })
                    {
                        <div class="mb-3">
                            <label class="form-label d-flex justify-content-between align-items-center">
                                <span>Промпт для AI</span>
                                <button type="button" class="btn btn-sm btn-outline-secondary" 
                                        @onclick="() => ShowVariablePicker(v => InsertVariable(aiData, nameof(aiData.Prompt), v))">
                                    <span class="oi oi-code"></span> {}
                                </button>
                            </label>
                            <textarea class="form-control font-monospace" 
                                      @bind="aiData.Prompt" 
                                      @oninput="OnWorkflowChanged"
                                      rows="6"></textarea>
                            <small class="form-text text-muted">
                                Опишите, что должен сделать AI. Используйте переменные <code>{{variable_name}}</code>.
                            </small>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Сохранить результат в переменную</label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input type="text" 
                                       class="form-control font-monospace" 
                                       @bind="aiData.Variable" 
                                       @oninput="OnWorkflowChanged"
                                       placeholder="например, ai_response"/>
                            </div>
                            <small class="form-text text-muted">
                                Имя переменной для сохранения ответа от AI.
                            </small>
                        </div>
                    }

                    @if (node is WorkflowNodeModel { Data: MediaNodeData mediaData })
                    {
                        <div class="mb-3">
                            <label class="form-label">Загрузить файл</label>
                            <InputFile class="form-control" OnChange="@(e => OnMediaFileSelected(e, mediaData))"/>
                            <small class="form-text text-muted">Файл будет загружен в хранилище, к блоку привяжется ID файла.</small>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Или выбрать из хранилища</label>
                            <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => LoadStorageFiles()">
                                <span class="oi oi-list"></span> Обновить список
                            </button>
                            @if (StorageFiles != null)
                            {
                                <select class="form-select mt-2" @bind="mediaData.Value" @bind:event="onchange" @bind:after="OnWorkflowChanged">
                                    <option value="">— Выберите файл —</option>
                                    @foreach (var f in StorageFiles)
                                    {
                                        <option value="@f.Id">@(f.Name ?? f.Id)</option>
                                    }
                                </select>
                            }
                        </div>
                        <div class="mb-3">
                            <label class="form-label d-flex justify-content-between align-items-center">
                                <span>Текущий ключ (ID файла)</span>
                                <button type="button" class="btn btn-sm btn-outline-secondary"
                                        @onclick="() => ShowVariablePicker(v => InsertVariable(mediaData, nameof(mediaData.Value), v))">
                                    <span class="oi oi-code"></span> {}
                                </button>
                            </label>
                            <input type="text" class="form-control font-monospace"
                                   @bind="mediaData.Value"
                                   @oninput="OnWorkflowChanged"
                                   placeholder="ID файла или {{variable_name}}"/>
                            <small class="form-text text-muted">Можно использовать переменные (например, <code>{{variable_name}}</code>).</small>
                        </div>
                        <div class="mb-3">
                            <label class="form-label d-flex justify-content-between align-items-center">
                                <span>Подпись (Caption)</span>
                                <button type="button" class="btn btn-sm btn-outline-secondary"
                                        @onclick="() => ShowVariablePicker(v => InsertVariable(mediaData, nameof(mediaData.Caption), v))">
                                    <span class="oi oi-code"></span> {}
                                </button>
                            </label>
                            <textarea class="form-control font-monospace" rows="2"
                                      @bind="mediaData.Caption"
                                      @oninput="OnWorkflowChanged"
                                      placeholder="Необязательно"></textarea>
                            <small class="form-text text-muted">Можно использовать переменные <code>{{variable_name}}</code>.</small>
                        </div>
                    }
                }
                else if (SelectedModel is WorkflowLinkModel link)
                {
                    <div class="section-title mb-3 fw-bold">Логика перехода</div>

                    <div class="mb-3">
                        <label class="form-label">Тип условия</label>
                        <select class="form-select"
                                @onchange="@(e => OnConditionTypeChanged(link, e.Value?.ToString()))">
                            <option value="none" selected="@(link.Condition == null)">Без условия (Всегда)</option>
                            <option value="equals" selected="@(link.Condition?.Equals != null)">Равно (==)</option>
                            <option value="contains" selected="@(link.Condition?.Contains != null)">Содержит (*)</option>
                        </select>
                    </div>

                    @if (link.Condition?.Equals != null)
                    {
                        <div class="card p-3 border-primary mb-3 shadow-sm">
                            <div class="mb-2">
                                <label class="small text-muted d-flex justify-content-between align-items-center">
                                    <span>Переменная</span>
                                    <button type="button" class="btn btn-sm btn-outline-secondary" 
                                            @onclick="() => ShowVariablePicker(v => link.Condition.Equals.Left = v)">
                                        <span class="oi oi-code"></span> Выбрать
                                    </button>
                                </label>
                                <input type="text" 
                                       class="form-control font-monospace" 
                                       @bind="link.Condition.Equals.Left"
                                       placeholder="$variable_name"/>
                            </div>
                            <div class="text-center my-1"><span class="badge bg-primary">РАВНО</span></div>
                            <div>
                                <label class="small text-muted d-flex justify-content-between align-items-center">
                                    <span>Значение</span>
                                    <button type="button" class="btn btn-sm btn-outline-secondary" 
                                            @onclick="() => ShowVariablePicker(v => InsertVariable(link.Condition.Equals, nameof(link.Condition.Equals.Right), v))">
                                        <span class="oi oi-code"></span> {}
                                    </button>
                                </label>
                                <input type="text" class="form-control" @bind="link.Condition.Equals.Right"/>
                            </div>
                        </div>
                    }
                    else if (link.Condition?.Contains != null)
                    {
                        <div class="card p-3 border-success mb-3 shadow-sm">
                            <div class="mb-2">
                                <label class="small text-muted d-flex justify-content-between align-items-center">
                                    <span>Переменная</span>
                                     <button type="button" class="btn btn-sm btn-outline-secondary" 
                                            @onclick="() => ShowVariablePicker(v => link.Condition.Contains.Left = v)">
                                        <span class="oi oi-code"></span> Выбрать
                                    </button>
                                </label>
                                <input type="text" 
                                       class="form-control font-monospace" 
                                       @bind="link.Condition.Contains.Left"
                                       placeholder="$variable_name"/>
                            </div>
                            <div class="text-center my-1"><span class="badge bg-success">СОДЕРЖИТ</span></div>
                            <div>
                                <label class="small text-muted d-flex justify-content-between align-items-center">
                                    <span>Подстрока</span>
                                    <button type="button" class="btn btn-sm btn-outline-secondary" 
                                            @onclick="() => ShowVariablePicker(v => InsertVariable(link.Condition.Contains, nameof(link.Condition.Contains.Right), v))">
                                        <span class="oi oi-code"></span> {}
                                    </button>
                                </label>
                                <input type="text" class="form-control" @bind="link.Condition.Contains.Right"/>
                            </div>
                        </div>
                    }

                    <div class="mb-3">
                        <label class="form-label">Текст на линии</label>
                        <input type="text" class="form-control" @bind="link.Label" placeholder="Да / Нет"/>
                    </div>
                }

                <hr/>
                <div class="mt-3">
                    <button class="btn btn-outline-danger w-100" @onclick="DeleteSelectedModel">
                        <span class="oi oi-trash"></span> Удалить
                    </button>
                </div>
            </div>
        </div>
    }

    <!-- Панель переменных (справа) -->
    <div class="variables-panel @(IsVariablesPanelOpen ? "open" : "")">
        <button class="variables-toggle" @onclick="ToggleVariablesPanel">
            <span class="oi oi-@(IsVariablesPanelOpen ? "chevron-right" : "chevron-left")"></span>
        </button>
        
        <div class="variables-content">
            <div class="variables-header">
                <h6><span class="oi oi-code"></span> Переменные</h6>
                <span class="badge bg-secondary">@DiscoveredVariables.Count</span>
            </div>

            <div class="variables-search mb-3">
                <input type="text" 
                       class="form-control form-control-sm" 
                       placeholder="Поиск переменных..."
                       @bind="VariableSearchQuery"
                       @bind:event="oninput"/>
            </div>

            <div class="variables-list">
                @if (!DiscoveredVariables.Any())
                {
                    <div class="text-center text-muted py-4">
                        <span class="oi oi-info"></span>
                        <p class="small mt-2">Переменные появятся автоматически<br/>при их использовании в узлах</p>
                    </div>
                }
                else
                {
                    @foreach (var group in GetGroupedVariables())
                    {
                        <div class="variable-group mb-3">
                            <div class="variable-group-title">
                                <small class="text-muted">
                                    @if (group.Key == "Контакт")
                                    {
                                        <span class="oi oi-person"></span>
                                    }
                                    @group.Key
                                </small>
                            </div>
                            @foreach (var variable in group.Value)
                            {
                                <div class="variable-item @GetVariableCssClass(variable)" 
                                     @onclick="() => CopyVariableToClipboard(variable.Name)"
                                     title="Клик для копирования">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div class="flex-grow-1">
                                            <code class="variable-name">@variable.Name</code>
                                            @if (!string.IsNullOrEmpty(variable.SourceNode))
                                            {
                                                <small class="d-block text-muted mt-1">
                                                    <span class="oi oi-arrow-thick-right"></span> @variable.SourceNode
                                                </small>
                                            }
                                        </div>
                                        <span class="badge bg-light text-dark">@variable.UsageCount</span>
                                    </div>
                                    @if (variable.UsageNodes.Any())
                                    {
                                        <div class="variable-usage mt-2">
                                            <small class="text-muted">Используется в:</small>
                                            @foreach (var usage in variable.UsageNodes.Take(3))
                                            {
                                                <span class="badge bg-info text-dark me-1">@usage</span>
                                            }
                                            @if (variable.UsageNodes.Count > 3)
                                            {
                                                <span class="badge bg-secondary">+@(variable.UsageNodes.Count - 3)</span>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                }
            </div>

            <div class="variables-footer">
                <button class="btn btn-sm btn-outline-primary w-100" @onclick="RefreshVariables">
                    <span class="oi oi-reload"></span> Обновить список
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal для выбора переменной -->
@if (IsVariablePickerOpen)
{
    <div class="modal-backdrop show"></div>
    <div class="modal show d-block" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Выбрать переменную</h5>
                    <button type="button" class="btn-close" @onclick="CloseVariablePicker"></button>
                </div>
                <div class="modal-body">
                    <input type="text" 
                           class="form-control mb-3" 
                           placeholder="Поиск..."
                           @bind="VariablePickerSearch"
                           @bind:event="oninput"/>
                    
                    @if (!GetFilteredVariablesForPicker().Any())
                    {
                        <div class="text-center text-muted py-3">
                            <p>Нет доступных переменных</p>
                            <small>Создайте переменные в узлах</small>
                        </div>
                    }
                    else
                    {
                        <div class="list-group">
                            @foreach (var variable in GetFilteredVariablesForPicker())
                            {
                                <button type="button" 
                                        class="list-group-item list-group-item-action"
                                        @onclick="() => SelectVariableFromPicker(variable.Name)">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <code>@variable.Name</code>
                                        <small class="text-muted">@variable.SourceNode</small>
                                    </div>
                                </button>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}