@page "/designer/{WorkflowId:guid}"
@using Blazor.Diagrams.Components
@attribute [Authorize]
@using Blazor.Diagrams.Components.Widgets
@using Blazor.Diagrams.Core.Models
@using System.Text.RegularExpressions
@using BlazorClient.Models.Diagram
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@layout DesignerLayout

<PageTitle>Редактор Workflow</PageTitle>

<div class="designer-page-container">
    <!-- Левая панель с узлами (референс code.html) -->
    <aside class="designer-sidebar">
        <div class="sidebar-brand">
            <a href="/" class="sidebar-brand-logo" title="ChatFoundry">
                <span class="sidebar-brand-icon sidebar-brand-icon--svg">
                    <svg width="28" height="28" viewBox="0 0 28 28" fill="none">
                        <rect width="28" height="28" rx="7" fill="url(#sidebar-logo-grad)" />
                        <path d="M8 10.5C8 9.67 8.67 9 9.5 9H18.5C19.33 9 20 9.67 20 10.5V16.5C20 17.33 19.33 18 18.5 18H13L10 21V18H9.5C8.67 18 8 17.33 8 16.5V10.5Z" fill="white" opacity="0.95"/>
                        <circle cx="12" cy="13.5" r="1" fill="url(#sidebar-logo-grad)"/>
                        <circle cx="16" cy="13.5" r="1" fill="url(#sidebar-logo-grad)"/>
                        <defs>
                            <linearGradient id="sidebar-logo-grad" x1="0" y1="0" x2="28" y2="28">
                                <stop offset="0%" stop-color="#6366f1"/>
                                <stop offset="100%" stop-color="#8b5cf6"/>
                            </linearGradient>
                        </defs>
                    </svg>
                </span>
            </a>
            <span class="sidebar-brand-text">ChatFoundry</span>
        </div>
        <div class="sidebar-search">
            <span class="sidebar-search-icon oi oi-magnifying-glass"></span>
            <input type="text" class="sidebar-search-input" placeholder="Поиск узлов..." 
                   @bind="NodeSearchQuery" @bind:event="oninput" />
        </div>
        <div class="sidebar-content">
            <div class="sidebar-section">
                <h3 class="sidebar-section-title">Логика</h3>
                <div class="node-list">
                    @foreach (var item in GetFilteredNodeTools().Where(x => x.Section == "Логика"))
                    {
                        <div class="node-tool" draggable="true" @ondragstart="e => OnDragStart(e, item.Type)">
                            <span class="node-tool-icon node-tool-icon--@item.IconClass"><span class="oi @item.Icon"></span></span>
                            <span class="node-tool-label">@item.Label</span>
                        </div>
                    }
                </div>
            </div>
            <div class="sidebar-section">
                <h3 class="sidebar-section-title">Контент</h3>
                <div class="node-list">
                    @foreach (var item in GetFilteredNodeTools().Where(x => x.Section == "Контент"))
                    {
                        <div class="node-tool" draggable="true" @ondragstart="e => OnDragStart(e, item.Type)">
                            <span class="node-tool-icon node-tool-icon--@item.IconClass"><span class="oi @item.Icon"></span></span>
                            <span class="node-tool-label">@item.Label</span>
                        </div>
                    }
                </div>
            </div>
            <div class="sidebar-section">
                <h3 class="sidebar-section-title">AI и интеграции</h3>
                <div class="node-list">
                    @foreach (var item in GetFilteredNodeTools().Where(x => x.Section == "AI и интеграции"))
                    {
                        <div class="node-tool" draggable="true" @ondragstart="e => OnDragStart(e, item.Type)">
                            <span class="node-tool-icon node-tool-icon--@item.IconClass"><span class="oi @item.Icon"></span></span>
                            <span class="node-tool-label">@item.Label</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </aside>

    <!-- Основная область: топ-бар + канвас -->
    <main class="designer-main">
        <header class="designer-header">
            <div class="designer-header-left">
                <span class="designer-workflow-title">Редактор Workflow</span>
                <span class="designer-badge">Editor</span>
                <span class="designer-header-divider"></span>
                <span class="designer-last-saved">@LastSavedText</span>
            </div>
            <div class="designer-header-right">
                <div class="designer-undo-redo">
                    <button type="button" class="designer-undo-btn" @onclick="Undo" disabled="@(_undoIndex <= 0)" title="Назад">
                        <span class="oi oi-arrow-left"></span>
                    </button>
                    <button type="button" class="designer-redo-btn" @onclick="Redo" disabled="@(_undoIndex >= _undoStack.Count - 1)" title="Вперёд">
                        <span class="oi oi-arrow-right"></span>
                    </button>
                </div>
                <button type="button" class="designer-btn-secondary" @onclick="OpenVariablesModal" title="Атрибуты и параметры">
                    <span class="oi oi-code"></span> Атрибуты и параметры
                </button>
                <div class="designer-json-dropdown">
                    <button type="button" class="designer-btn-secondary" @onclick="() => _jsonMenuOpen = !_jsonMenuOpen" title="Экспорт / импорт JSON">
                        <span class="oi oi-document"></span> JSON <span class="oi oi-chevron-bottom"></span>
                    </button>
                    @if (_jsonMenuOpen)
                    {
                        <div class="designer-json-dropdown-backdrop" @onclick="() => _jsonMenuOpen = false"></div>
                        <ul class="dropdown-menu dropdown-menu-end show">
                            <li><button type="button" class="dropdown-item" @onclick="CloseJsonMenuAndDownload"><span class="oi oi-data-transfer-download"></span> Скачать</button></li>
                            <li><button type="button" class="dropdown-item" @onclick="TriggerImportJsonFile"><span class="oi oi-data-transfer-upload"></span> Загрузить</button></li>
                        </ul>
                    }
                </div>
                <div id="workflow-json-file-wrap" class="d-none">
                    <InputFile accept=".json,application/json" OnChange="OnImportWorkflowJson" />
                </div>
                <button type="button" class="designer-btn-primary designer-header-save" @onclick="SaveWorkflow" title="Сохранить">
                    <span class="oi oi-circle-check"></span> Сохранить
                </button>
            </div>
        </header>
        @if (!string.IsNullOrEmpty(_loadError))
        {
            <div class="alert alert-danger m-3" role="alert">
                @_loadError
            </div>
        }
        <div id="designer-canvas-area" class="canvas-area" 
             @ondrop="OnDrop" 
             @ondragover="OnDragOver" 
             @ondragover:preventDefault="true">
            <CascadingValue Value="Diagram">
                <DiagramCanvas class="designer-canvas">
                    <Widgets>
                        <GridWidget Size="24" Mode="GridMode.Point" BackgroundColor="#ffffff"/>
                        <SelectionBoxWidget/>
                    </Widgets>
                </DiagramCanvas>
            </CascadingValue>

            <!-- Зум: слева снизу -->
            <div class="designer-zoom-controls">
                <button type="button" class="designer-zoom-btn" @onclick="ZoomOut" title="Уменьшить">
                    <span class="oi oi-minus"></span>
                </button>
                <span class="designer-zoom-value">@(ZoomPercent)%</span>
                <button type="button" class="designer-zoom-btn" @onclick="ZoomIn" title="Увеличить">
                    <span class="oi oi-plus"></span>
                </button>
            </div>

            <!-- Мини-карта: справа снизу -->
            <div class="designer-minimap">
                <div class="designer-minimap-title">Карта</div>
                <div class="designer-minimap-content">
                    @if (Diagram != null)
                    {
                        @foreach (var node in Diagram.Nodes.Cast<WorkflowNodeModel>())
                        {
                            <div class="designer-minimap-node" 
                                 style="left: @(node.Position.X / 25)px; top: @(node.Position.Y / 25)px;"
                                 title="@node.Title"></div>
                        }
                    }
                </div>
            </div>
        </div>

        <!-- Панель настроек узла (справа, референс code.html) -->
        @if (SelectedModel != null)
        {
            <div class="designer-settings-panel">
            <div class="panel-header">
                <h6>Настройки</h6>
                <button type="button" class="btn-close" @onclick="() => SelectedModel = null"></button>
            </div>
            <div class="panel-body">
                @if (SelectedModel is NodeModel node)
                {
                    <div class="mb-3">
                        <label class="form-label">Заголовок</label>
                        <input type="text" class="form-control" @bind-value="node.Title" @bind-value:event="oninput"/>
                    </div>

                    @if (node is WorkflowNodeModel { Data: MessageNodeData msgData })
                    {
                        <div class="mb-3">
                            <label class="form-label d-flex justify-content-between align-items-center">
                                <span>Текст сообщения</span>
                                <button type="button" class="btn btn-sm btn-outline-secondary" 
                                        @onclick="() => ShowVariablePicker(v => InsertVariable(msgData, nameof(msgData.Text), v))">
                                    <span class="oi oi-code"></span> {}
                                </button>
                            </label>
                            <textarea class="form-control font-monospace variable-input" 
                                      value="@ToDisplayText(msgData.Text)"
                                      @oninput="e => { UpdateFieldAndCheckAtMention(e, msgData, nameof(msgData.Text)); OnWorkflowChanged(); }"
                                      rows="4"></textarea>
                            <small class="form-text text-muted">
                                Введите <kbd>@@</kbd> для выбора переменной. Или <code>{{variable_name}}</code>
                            </small>
                        </div>
                    }

                    @if (node is WorkflowNodeModel { Data: AskNodeData askData })
                    {
                        <div class="mb-3">
                            <label class="form-label d-flex justify-content-between align-items-center">
                                <span>Текст вопроса</span>
                                <button type="button" class="btn btn-sm btn-outline-secondary" 
                                        @onclick="() => ShowVariablePicker(v => InsertVariable(askData, nameof(askData.Text), v))">
                                    <span class="oi oi-code"></span> {}
                                </button>
                            </label>
                            <textarea class="form-control font-monospace variable-input" 
                                      value="@ToDisplayText(askData.Text)"
                                      @oninput="e => { UpdateFieldAndCheckAtMention(e, askData, nameof(askData.Text)); OnWorkflowChanged(); }"
                                      rows="4"></textarea>
                            <small class="form-text text-muted">
                                Введите <kbd>@@</kbd> для выбора переменной. Или <code>{{variable_name}}</code>
                            </small>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Кнопки (отправляются под сообщением)</label>
                            @if (askData.Ui?.Buttons != null)
                            {
                                @foreach (var btn in askData.Ui.Buttons.ToList())
                                {
                                    <div class="input-group mb-2">
                                        <input type="text"
                                               class="form-control"
                                               placeholder="Текст на кнопке"
                                               value="@ToDisplayText(btn.Text)"
                                               @oninput="e => { btn.Text = FromDisplayText(e.Value?.ToString() ?? string.Empty); OnWorkflowChanged(); }"/>
                                        <input type="text"
                                               class="form-control font-monospace"
                                               placeholder="Значение (в переменную)"
                                               value="@ToDisplayText(btn.Value)"
                                               @oninput="e => { btn.Value = FromDisplayText(e.Value?.ToString() ?? string.Empty); OnWorkflowChanged(); }"/>
                                        <button type="button" class="btn btn-outline-danger" @onclick="() => RemoveAskButton(askData, btn)">
                                            <span class="oi oi-trash"></span>
                                        </button>
                                    </div>
                                }
                            }
                            <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => AddAskButton(askData)">
                                <span class="oi oi-plus"></span> Добавить кнопку
                            </button>
                            <small class="form-text text-muted d-block mt-1">
                                При нажатии пользователем в переменную попадёт «Значение». Если кнопок нет — ожидается любой ввод.
                            </small>
                        </div>
                    }

                    @if (node is WorkflowNodeModel { Data: SetAttributeNodeData attrData })
                    {
                        <div class="mb-3">
                            <label class="form-label">Ключ атрибута</label>
                            <select class="form-select font-monospace" 
                                    value="@NormalizeAttributeKey(attrData.Attribute)"
                                    @onchange="@(e => OnAttributeKeyChanged(attrData, e))">
                                <option value="">— Выберите атрибут —</option>
                                @foreach (var key in GetAttributeKeysForDropdown())
                                {
                                    <option value="@key">$global.@key</option>
                                }
                            </select>
                            <small class="form-text text-muted">
                                Список из атрибутов компании (Компания → Атрибуты) и базовых: name, username, phone, email
                            </small>
                        </div>
                        <div class="mb-3">
                            <label class="form-label d-flex justify-content-between align-items-center">
                                <span>Значение</span>
                                <button type="button" class="btn btn-sm btn-outline-secondary" 
                                        @onclick="() => ShowVariablePicker(v => InsertVariable(attrData, nameof(attrData.Value), v))">
                                    <span class="oi oi-code"></span> {}
                                </button>
                            </label>
                            <input type="text" 
                                   class="form-control font-monospace" 
                                   value="@ToDisplayText(attrData.Value)"
                                   @oninput="e => { attrData.Value = FromDisplayText(e.Value?.ToString() ?? string.Empty); OnWorkflowChanged(); }"
                                   placeholder="Текст или {{variable_name}}"/>
                            <small class="form-text text-muted">
                                В шаблоне можно использовать переменные
                            </small>
                        </div>
                    }

                    @if (node is WorkflowNodeModel { Data: HttpRequestNodeData httpData })
                    {
                        <div class="mb-3">
                            <label class="form-label">Метод</label>
                            <select class="form-select" @bind="httpData.Method">
                                <option value="GET">GET</option>
                                <option value="POST">POST</option>
                                <option value="PUT">PUT</option>
                                <option value="DELETE">DELETE</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label d-flex justify-content-between align-items-center">
                                <span>URL</span>
                                <button type="button" class="btn btn-sm btn-outline-secondary" 
                                        @onclick="() => ShowVariablePicker(v => InsertVariable(httpData, nameof(httpData.Url), v))">
                                    <span class="oi oi-code"></span> {}
                                </button>
                            </label>
                            <input type="text"
                                   class="form-control font-monospace"
                                   value="@ToDisplayText(httpData.Url)"
                                   @oninput="e => { httpData.Url = FromDisplayText(e.Value?.ToString() ?? string.Empty); OnWorkflowChanged(); }"
                                   placeholder="https://api.example.com/data"/>
                        </div>

                        @if (httpData.Method == "POST" || httpData.Method == "PUT")
                        {
                            <div class="mb-3">
                                <label class="form-label d-flex justify-content-between align-items-center">
                                    <span>Тело запроса (Body)</span>
                                    <button type="button" class="btn btn-sm btn-outline-secondary" 
                                            @onclick="() => ShowVariablePicker(v => InsertVariable(httpData, nameof(httpData.Body), v))">
                                        <span class="oi oi-code"></span> {}
                                    </button>
                                </label>
                                <textarea class="form-control font-monospace"
                                          rows="5"
                                          value="@ToDisplayText(httpData.Body)"
                                          @oninput="e => { httpData.Body = FromDisplayText(e.Value?.ToString() ?? string.Empty); OnWorkflowChanged(); }"
                                          placeholder='{"key": "{{variable_name}}"}'></textarea>
                            </div>
                        }

                        <div class="mb-3">
                            <label class="form-label">Заголовки</label>
                            @foreach (var header in httpData.Headers.ToList())
                            {
                                <div class="input-group mb-2">
                                    <input type="text" class="form-control" placeholder="Header Name" value="@header.Key"
                                           @onchange="@(e => { var newKey = e.Value.ToString(); if (!string.IsNullOrWhiteSpace(newKey)) { httpData.Headers.Remove(header.Key); httpData.Headers[newKey] = header.Value; }})"/>
                                    <input type="text"
                                           class="form-control"
                                           placeholder="Header Value"
                                           value="@ToDisplayText(httpData.Headers[header.Key])"
                                           @oninput="e => { httpData.Headers[header.Key] = FromDisplayText(e.Value?.ToString() ?? string.Empty); OnWorkflowChanged(); }" />
                                    <button class="btn btn-outline-danger" @onclick="() => httpData.Headers.Remove(header.Key)">
                                        <span class="oi oi-trash"></span>
                                    </button>
                                </div>
                            }
                            <button class="btn btn-sm btn-outline-primary" @onclick="() => AddHeader(httpData)">
                                <span class="oi oi-plus"></span> Добавить заголовок
                            </button>
                        </div>
                    }

                    @if (node is WorkflowNodeModel { Data: AIGenerateNodeData aiData })
                    {
                        <div class="mb-3">
                            <label class="form-label d-flex justify-content-between align-items-center">
                                <span>Промпт для AI</span>
                                <button type="button" class="btn btn-sm btn-outline-secondary" 
                                        @onclick="() => ShowVariablePicker(v => InsertVariable(aiData, nameof(aiData.Prompt), v))">
                                    <span class="oi oi-code"></span> {}
                                </button>
                            </label>
                            <textarea class="form-control font-monospace" 
                                      value="@ToDisplayText(aiData.Prompt)"
                                      @oninput="e => { aiData.Prompt = FromDisplayText(e.Value?.ToString() ?? string.Empty); OnWorkflowChanged(); }"
                                      rows="6"></textarea>
                            <small class="form-text text-muted">
                                Опишите, что должен сделать AI. Используйте переменные <code>{{variable_name}}</code>.
                            </small>
                        </div>
                    }

                    @if (node is WorkflowNodeModel { Data: MediaNodeData mediaData })
                    {
                        <div class="mb-3">
                            <label class="form-label">Загрузить файл</label>
                            <InputFile class="form-control" OnChange="@(e => OnMediaFileSelected(e, mediaData))"/>
                            <small class="form-text text-muted">Файл будет загружен в хранилище, к блоку привяжется ID файла.</small>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Или выбрать из хранилища</label>
                            <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => LoadStorageFiles()">
                                <span class="oi oi-list"></span> Обновить список
                            </button>
                            @if (StorageFiles != null)
                            {
                                <select class="form-select mt-2" @bind="mediaData.Value" @bind:event="onchange" @bind:after="OnWorkflowChanged">
                                    <option value="">— Выберите файл —</option>
                                    @foreach (var f in StorageFiles)
                                    {
                                        <option value="@f.Id">@(f.Name ?? f.Id)</option>
                                    }
                                </select>
                            }
                        </div>
                        <div class="mb-3">
                            <label class="form-label d-flex justify-content-between align-items-center">
                                <span>Текущий ключ (ID файла)</span>
                                <button type="button" class="btn btn-sm btn-outline-secondary"
                                        @onclick="() => ShowVariablePicker(v => InsertVariable(mediaData, nameof(mediaData.Value), v))">
                                    <span class="oi oi-code"></span> {}
                                </button>
                            </label>
                            <input type="text" class="form-control font-monospace"
                                   value="@ToDisplayText(mediaData.Value)"
                                   @oninput="e => { mediaData.Value = FromDisplayText(e.Value?.ToString() ?? string.Empty); OnWorkflowChanged(); }"
                                   placeholder="ID файла или {{variable_name}}"/>
                            <small class="form-text text-muted">Можно использовать переменные (например, <code>{{variable_name}}</code>).</small>
                        </div>
                        <div class="mb-3">
                            <label class="form-label d-flex justify-content-between align-items-center">
                                <span>Подпись (Caption)</span>
                                <button type="button" class="btn btn-sm btn-outline-secondary"
                                        @onclick="() => ShowVariablePicker(v => InsertVariable(mediaData, nameof(mediaData.Caption), v))">
                                    <span class="oi oi-code"></span> {}
                                </button>
                            </label>
                            <textarea class="form-control font-monospace" rows="2"
                                      value="@ToDisplayText(mediaData.Caption)"
                                      @oninput="e => { mediaData.Caption = FromDisplayText(e.Value?.ToString() ?? string.Empty); OnWorkflowChanged(); }"
                                      placeholder="Необязательно"></textarea>
                            <small class="form-text text-muted">Можно использовать переменные <code>{{variable_name}}</code>.</small>
                        </div>
                    }

                    @if (node is WorkflowNodeModel { Data: SubWorkflowNodeData subData })
                    {
                        <div class="mb-3">
                            <label class="form-label">Вызываемый процесс</label>
                            @if (subData.WorkflowId != Guid.Empty && (AvailableWorkflows?.FirstOrDefault(w => w.Id == subData.WorkflowId)) is { } selectedW)
                            {
                                <div class="d-flex align-items-center gap-2 flex-wrap">
                                    <span class="text-muted">@GetWorkflowDisplayName(selectedW)</span>
                                    <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => OpenProcessPicker(subData)">
                                        <span class="oi oi-pencil"></span> Изменить
                                    </button>
                                </div>
                            }
                            else
                            {
                                <div class="d-flex align-items-center gap-2 flex-wrap">
                                    @if (subData.WorkflowId != Guid.Empty)
                                    {
                                        <span class="text-muted">Процесс выбран</span>
                                    }
                                    <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => OpenProcessPicker(subData)">
                                        <span class="oi @(subData.WorkflowId != Guid.Empty ? "oi-pencil" : "oi-plus")"></span> @(subData.WorkflowId != Guid.Empty ? "Изменить" : "Выбрать процесс")
                                    </button>
                                </div>
                            }
                        </div>

                        @if (subData.WorkflowId != Guid.Empty)
                        {
                            <div class="mb-3">
                                <label class="form-label fw-bold">Входные параметры</label>
                                <small class="form-text text-muted d-block mb-2">
                                    Привяжите параметры дочернего процесса к переменным или значениям текущего (можно <code>{{variable}}</code>).
                                </small>
                                @foreach (var mapping in subData.InputMappings.ToList())
                                {
                                    <div class="input-group mb-2">
                                        <span class="input-group-text font-monospace" style="min-width:120px;">@mapping.Key</span>
                                        <input type="text" class="form-control font-monospace"
                                               value="@ToDisplayText(mapping.Value)"
                                               placeholder="{{variable}} или значение"
                                               @oninput="e => { subData.InputMappings[mapping.Key] = FromDisplayText(e.Value?.ToString() ?? string.Empty); OnWorkflowChanged(); }" />
                                        <button type="button" class="btn btn-sm btn-outline-secondary"
                                                @onclick="() => ShowVariablePicker(v => InsertVariableIntoMapping(subData.InputMappings, mapping.Key, v))">
                                            <span class="oi oi-code"></span>
                                        </button>
                                    </div>
                                }
                                @if (!subData.InputMappings.Any())
                                {
                                    <p class="small text-muted">У выбранного процесса нет входных параметров. Задайте их во вкладке «Параметры» в настройках того процесса.</p>
                                }
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold">Выходные параметры</label>
                                <small class="form-text text-muted d-block mb-2">
                                    Укажите, в какую переменную текущего процесса записать результат дочернего (слева — переменная, справа — параметр дочернего).
                                </small>
                                @foreach (var mapping in subData.OutputMappings.ToList())
                                {
                                    <div class="input-group mb-2">
                                        <span class="input-group-text">$</span>
                                        <input type="text" class="form-control font-monospace" style="max-width:40%;"
                                               value="@mapping.Key"
                                               placeholder="переменная"
                                               @oninput="e => { var newKey = e.Value?.ToString() ?? string.Empty; if (!string.IsNullOrWhiteSpace(newKey) && newKey != mapping.Key) { var val = subData.OutputMappings[mapping.Key]; subData.OutputMappings.Remove(mapping.Key); subData.OutputMappings[newKey] = val; OnWorkflowChanged(); } }" />
                                        <span class="input-group-text">&#8592;</span>
                                        <input type="text" class="form-control font-monospace"
                                               value="@mapping.Value"
                                               placeholder="параметр дочернего"
                                               readonly
                                               tabindex="-1" />
                                    </div>
                                }
                                @if (!subData.OutputMappings.Any())
                                {
                                    <p class="small text-muted">У выбранного процесса нет выходных параметров. Задайте их во вкладке «Параметры» в настройках того процесса.</p>
                                }
                            </div>
                        }
                    }
                }
                else if (SelectedModel is WorkflowLinkModel link)
                {
                    <div class="section-title mb-3 fw-bold">Логика перехода</div>

                    <div class="mb-3">
                        <label class="form-label">Тип условия</label>
                        <select class="form-select"
                                @onchange="@(e => OnConditionTypeChanged(link, e.Value?.ToString()))">
                            <option value="none" selected="@(link.Condition == null)">Без условия (Всегда)</option>
                            <option value="equals" selected="@(link.Condition?.Equals != null)">Равно (==)</option>
                            <option value="contains" selected="@(link.Condition?.Contains != null)">Содержит (*)</option>
                        </select>
                    </div>

                    @if (link.Condition?.Equals != null)
                    {
                        <div class="card p-3 border-primary mb-3 shadow-sm">
                            <div class="mb-2">
                                <label class="small text-muted d-flex justify-content-between align-items-center">
                                    <span>Переменная</span>
                                    <button type="button" class="btn btn-sm btn-outline-secondary" 
                                            @onclick="() => ShowVariablePicker(v => link.Condition.Equals.Left = v)">
                                        <span class="oi oi-code"></span> Выбрать
                                    </button>
                                </label>
                                <input type="text" 
                                       class="form-control font-monospace" 
                                       @bind="link.Condition.Equals.Left"
                                       placeholder="$variable_name"/>
                            </div>
                            <div class="text-center my-1"><span class="badge bg-primary">РАВНО</span></div>
                            <div>
                                <label class="small text-muted d-flex justify-content-between align-items-center">
                                    <span>Значение</span>
                                    <button type="button" class="btn btn-sm btn-outline-secondary" 
                                            @onclick="() => ShowVariablePicker(v => InsertVariable(link.Condition.Equals, nameof(link.Condition.Equals.Right), v))">
                                        <span class="oi oi-code"></span> {}
                                    </button>
                                </label>
                                <input type="text" class="form-control" @bind="link.Condition.Equals.Right"/>
                            </div>
                        </div>
                    }
                    else if (link.Condition?.Contains != null)
                    {
                        <div class="card p-3 border-success mb-3 shadow-sm">
                            <div class="mb-2">
                                <label class="small text-muted d-flex justify-content-between align-items-center">
                                    <span>Переменная</span>
                                     <button type="button" class="btn btn-sm btn-outline-secondary" 
                                            @onclick="() => ShowVariablePicker(v => link.Condition.Contains.Left = v)">
                                        <span class="oi oi-code"></span> Выбрать
                                    </button>
                                </label>
                                <input type="text" 
                                       class="form-control font-monospace" 
                                       @bind="link.Condition.Contains.Left"
                                       placeholder="$variable_name"/>
                            </div>
                            <div class="text-center my-1"><span class="badge bg-success">СОДЕРЖИТ</span></div>
                            <div>
                                <label class="small text-muted d-flex justify-content-between align-items-center">
                                    <span>Подстрока</span>
                                    <button type="button" class="btn btn-sm btn-outline-secondary" 
                                            @onclick="() => ShowVariablePicker(v => InsertVariable(link.Condition.Contains, nameof(link.Condition.Contains.Right), v))">
                                        <span class="oi oi-code"></span> {}
                                    </button>
                                </label>
                                <input type="text" class="form-control" @bind="link.Condition.Contains.Right"/>
                            </div>
                        </div>
                    }

                    <div class="mb-3">
                        <label class="form-label">Текст на линии</label>
                        <input type="text" class="form-control" @bind="link.Label" placeholder="Да / Нет"/>
                    </div>
                }

                <hr/>
                <div class="mt-3">
                    <button class="btn btn-outline-danger w-100" @onclick="DeleteSelectedModel">
                        <span class="oi oi-trash"></span> Удалить
                    </button>
                </div>
            </div>
        </div>
        }

    </main>
</div>

<!-- Модальное окно «Атрибуты и параметры» (2 вкладки) -->
@if (IsVariablesModalOpen)
{
    <div class="variables-modal-backdrop" @onclick="CloseVariablesModal"></div>
    <div class="variables-modal">
        <div class="variables-modal-header">
            <h2 class="variables-modal-title">Атрибуты и параметры</h2>
            <button type="button" class="variables-modal-close" @onclick="CloseVariablesModal" aria-label="Закрыть">
                <span class="oi oi-x"></span>
            </button>
        </div>
        <div class="variables-modal-tabs">
            <button type="button" class="variables-modal-tab @(VariablesModalTab == 0 ? "active" : "")" @onclick="() => VariablesModalTab = 0">
                Атрибуты
            </button>
            <button type="button" class="variables-modal-tab @(VariablesModalTab == 1 ? "active" : "")" @onclick="() => VariablesModalTab = 1">
                Параметры
            </button>
        </div>
        <div class="variables-modal-body">
            @if (VariablesModalTab == 0)
            {
                <div class="variables-modal-list">
                    @{
                        var attrKeys = GetAttributeKeysForModal().ToList();
                        var attrDisplay = CompanyAttributeDefinitions.ToDictionary(a => a.Key, a => a.DisplayName ?? a.Key, StringComparer.OrdinalIgnoreCase);
                    }
                    @if (!attrKeys.Any())
                    {
                        <p class="variables-modal-empty">Атрибуты настраиваются в разделе Компания → Атрибуты.</p>
                    }
                    else
                    {
                        @foreach (var key in attrKeys)
                        {
                            <div class="variables-modal-item var-global">
                                <code>$global.@key</code>
                                <span class="text-muted">@(attrDisplay.TryGetValue(key, out var dn) ? dn : GetAttributeDisplayName(key))</span>
                            </div>
                        }
                    }
                </div>
            }
            else
            {
                <p class="form-text text-muted mb-3">Параметры процесса задаются здесь. При вызове этого процесса из узла «Процесс» в другом workflow можно будет только связать эти параметры с переменными.</p>
                <p class="form-text text-muted mb-3">В этом же процессе подставьте значение параметра в любом узле (Сообщение, Вопрос, Переменная, Условие и т.д.): нажмите кнопку выбора переменной рядом с полем или введите вручную <code>{{имя_параметра}}</code> (например, <code>{{user_query}}</code>).</p>
                <div class="variables-modal-group mb-4">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <div class="variables-modal-group-title">Входные параметры</div>
                        <button type="button" class="btn btn-sm btn-outline-primary" @onclick="AddWorkflowInputParameter">
                            <span class="oi oi-plus"></span> Добавить
                        </button>
                    </div>
                    @if (!CurrentWorkflowInputParameters.Any())
                    {
                        <p class="variables-modal-empty small">Нет входных параметров. Добавьте параметры с названием и описанием.</p>
                    }
                    else
                    {
                        @foreach (var p in CurrentWorkflowInputParameters.ToList())
                        {
                            <div class="card card-body p-2 mb-2">
                                <div class="row g-2">
                                    <div class="col">
                                        <input type="text" class="form-control form-control-sm" placeholder="Название (например, user_query)" @bind="p.Name" @oninput="OnWorkflowChanged" />
                                    </div>
                                    <div class="col">
                                        <input type="text" class="form-control form-control-sm" placeholder="Значение по умолчанию" @bind="p.DefaultValue" @oninput="OnWorkflowChanged" />
                                    </div>
                                    <div class="col-auto">
                                        <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => RemoveWorkflowInputParameter(p)"><span class="oi oi-trash"></span></button>
                                    </div>
                                </div>
                                <input type="text" class="form-control form-control-sm mt-1" placeholder="Описание" @bind="p.Description" @oninput="OnWorkflowChanged" />
                            </div>
                        }
                    }
                </div>
                <div class="variables-modal-group">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <div class="variables-modal-group-title">Выходные параметры</div>
                        <button type="button" class="btn btn-sm btn-outline-primary" @onclick="AddWorkflowOutputParameter">
                            <span class="oi oi-plus"></span> Добавить
                        </button>
                    </div>
                    @if (!CurrentWorkflowOutputParameters.Any())
                    {
                        <p class="variables-modal-empty small">Нет выходных параметров. Добавьте параметры с названием и описанием.</p>
                    }
                    else
                    {
                        @foreach (var p in CurrentWorkflowOutputParameters.ToList())
                        {
                            <div class="card card-body p-2 mb-2">
                                <div class="d-flex gap-2 align-items-center">
                                    <input type="text" class="form-control form-control-sm" placeholder="Название (например, result)" @bind="p.Name" @oninput="OnWorkflowChanged" />
                                    <input type="text" class="form-control form-control-sm" placeholder="Описание" @bind="p.Description" @oninput="OnWorkflowChanged" />
                                    <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => RemoveWorkflowOutputParameter(p)"><span class="oi oi-trash"></span></button>
                                </div>
                            </div>
                        }
                    }
                </div>
            }
        </div>
    </div>
}

<!-- Модальное окно выбора переменной (референс code1.html) -->
@if (IsVariablePickerOpen)
{
    <div class="variable-picker-backdrop" @onclick="CloseVariablePicker"></div>
    <div class="variable-picker-modal" role="dialog">
        <div class="variable-picker-header">
            <h2 class="variable-picker-title">Выбрать переменную</h2>
            <button type="button" class="variable-picker-close" @onclick="CloseVariablePicker" aria-label="Закрыть">
                <span class="oi oi-x"></span>
            </button>
        </div>
        
        @if (VariablePickerSelectedNode == null)
        {
            <div class="variable-picker-search-wrap">
                <span class="variable-picker-search-icon oi oi-magnifying-glass"></span>
                <input type="text"
                       class="variable-picker-search"
                       placeholder="Поиск по блокам и переменным..."
                       @bind="VariablePickerSearch"
                       @bind:event="oninput" />
            </div>
            <div class="variable-picker-list">
                <div class="variable-picker-category">
                    <div class="variable-picker-category-title">Блоки</div>
                    <div class="variable-picker-items">
                        @foreach (var node in GetFilteredNodesForVariablePicker())
                        {
                            <button type="button"
                                    class="variable-picker-item variable-picker-item--custom"
                                    @onclick="() => SelectNodeForVariablePicker(node)">
                                <span class="variable-picker-item-icon">
                                    <span class="oi @GetNodeIcon(node)"></span>
                                </span>
                                <div class="variable-picker-item-body">
                                    <span class="variable-picker-item-name">@node.Title</span>
                                    <span class="variable-picker-item-code">@node.NodeType</span>
                                </div>
                                <span class="variable-picker-item-add oi oi-chevron-right"></span>
                            </button>
                        }
                        @if (!GetFilteredNodesForVariablePicker().Any())
                        {
                            <div class="variable-picker-empty">
                                <p>Нет блоков</p>
                                <small>Добавьте блоки на схему</small>
                            </div>
                        }
                    </div>
                </div>

                @foreach (var group in GetGroupedStaticVariablesForPicker())
                {
                    <div class="variable-picker-category">
                        <div class="variable-picker-category-title">@group.Key</div>
                        <div class="variable-picker-items">
                            @foreach (var variable in group.Value)
                            {
                                <button type="button"
                                        class="variable-picker-item variable-picker-item--@GetVariableTypeCss(variable.Type)"
                                        @onclick="() => SelectVariableFromPicker(variable.Name)">
                                    <span class="variable-picker-item-icon">
                                        <span class="oi @GetVariableIcon(variable.Type)"></span>
                                    </span>
                                    <div class="variable-picker-item-body">
                                        <span class="variable-picker-item-name">@GetVariableDisplayName(variable)</span>
                                        <span class="variable-picker-item-code">@variable.Name</span>
                                    </div>
                                    <span class="variable-picker-item-add oi oi-plus"></span>
                                </button>
                            }
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="variable-picker-search-wrap">
                <button type="button" class="btn btn-sm btn-outline-secondary me-2" @onclick="BackToVariablePickerNodes" title="Назад">
                    <span class="oi oi-chevron-left"></span>
                </button>
                <span class="variable-picker-search-icon oi oi-magnifying-glass"></span>
                <input type="text"
                       class="variable-picker-search"
                       placeholder="Поиск по переменным блока..."
                       @bind="VariablePickerSearch"
                       @bind:event="oninput" />
            </div>
            <div class="variable-picker-list">
                @{
                    var vars = GetVariablesForSelectedNode();
                }
                @if (!vars.Any())
                {
                    <div class="variable-picker-empty">
                        <p>У этого блока нет переменных</p>
                        <small>Выберите другой блок</small>
                    </div>
                }
                else
                {
                    <div class="variable-picker-category">
                        <div class="variable-picker-category-title">@VariablePickerSelectedNode.Title</div>
                        <div class="variable-picker-items">
                            @foreach (var v in vars)
                            {
                                <button type="button"
                                        class="variable-picker-item variable-picker-item--custom"
                                        @onclick="() => SelectVariableFromPicker(v.Key)">
                                    <span class="variable-picker-item-icon">
                                        <span class="oi oi-code"></span>
                                    </span>
                                    <div class="variable-picker-item-body">
                                        <span class="variable-picker-item-name">@v.Display</span>
                                        <span class="variable-picker-item-code">@GetVariableKeyShortDisplay(v.Key)</span>
                                    </div>
                                    <span class="variable-picker-item-add oi oi-plus"></span>
                                </button>
                            }
                        </div>
                    </div>
                }
            </div>
        }

        <div class="variable-picker-footer">
            <p class="variable-picker-footer-tip">
                <span class="oi oi-info"></span>
                Нажмите на переменную, чтобы вставить её в текущий узел.
            </p>
        </div>
    </div>
}

<!-- Модальное окно выбора процесса (поиск + пагинация) -->
@if (IsProcessPickerOpen)
{
    <div class="variable-picker-backdrop" @onclick="CloseProcessPicker"></div>
    <div class="variable-picker-modal" role="dialog" style="max-width: 420px;">
        <div class="variable-picker-header">
            <h2 class="variable-picker-title">Выбрать процесс</h2>
            <button type="button" class="variable-picker-close" @onclick="CloseProcessPicker" aria-label="Закрыть">
                <span class="oi oi-x"></span>
            </button>
        </div>
        <div class="variable-picker-search-wrap">
            <span class="variable-picker-search-icon oi oi-magnifying-glass"></span>
            <input type="text"
                   class="variable-picker-search"
                   placeholder="Поиск по названию бота..."
                   @bind="ProcessPickerSearch"
                   @bind:event="oninput" />
            <button type="button" class="btn btn-sm btn-outline-primary ms-2" @onclick="OnProcessPickerSearchSubmit">Искать</button>
        </div>
        <div class="variable-picker-list" style="min-height: 200px;">
            @if (ProcessPickerLoading)
            {
                <div class="variable-picker-empty">
                    <p>Загрузка...</p>
                </div>
            }
            else if (!ProcessPickerItems.Any())
            {
                <div class="variable-picker-empty">
                    <p>Нет процессов</p>
                    <small>Добавьте процессы в настройках бота</small>
                </div>
            }
            else
            {
                @foreach (var w in ProcessPickerItems)
                {
                    <button type="button"
                            class="variable-picker-item variable-picker-item--custom"
                            @onclick="() => SelectProcessFromPicker(w)">
                        <span class="variable-picker-item-icon"><span class="oi oi-layers"></span></span>
                        <div class="variable-picker-item-body">
                            <span class="variable-picker-item-name">@GetWorkflowDisplayName(w)</span>
                            <span class="variable-picker-item-code">v@w.Version</span>
                        </div>
                        <span class="variable-picker-item-add oi oi-plus"></span>
                    </button>
                }
            }
        </div>
        <div class="d-flex justify-content-between align-items-center px-3 py-2 border-top">
            <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(!ProcessPickerHasPrev)" @onclick="ProcessPickerPrevPage">
                <span class="oi oi-chevron-left"></span> Назад
            </button>
            <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(!ProcessPickerHasNext)" @onclick="ProcessPickerNextPage">
                Вперёд <span class="oi oi-chevron-right"></span>
            </button>
        </div>
    </div>
}