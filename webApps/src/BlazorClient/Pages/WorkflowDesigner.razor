@page "/designer/{WorkflowId:guid}"
@using Blazor.Diagrams.Components
@using Blazor.Diagrams.Components.Widgets
@using Blazor.Diagrams.Core.Models
@layout MainLayout

<PageTitle>Редактор Workflow</PageTitle>

<div class="designer-page-container">
    <div class="designer-sidebar">
        <div class="sidebar-header">
            <h5>Узлы</h5>
        </div>
        <div class="sidebar-content">
            <div class="sidebar-section">
                <small>ЛОГИКА</small>
                <div class="node-grid">
                    <div class="node-tool" draggable="true" @ondragstart="e => OnDragStart(e, NodeType.Start)"><span
                            class="oi oi-media-play"></span> Старт
                    </div>
                    <div class="node-tool" draggable="true" @ondragstart="e => OnDragStart(e, NodeType.Condition)"><span
                            class="oi oi-fork"></span> Условие
                    </div>
                    <div class="node-tool" draggable="true" @ondragstart="e => OnDragStart(e, NodeType.Wait)"><span
                            class="oi oi-timer"></span> Ожидание
                    </div>
                    <div class="node-tool" draggable="true" @ondragstart="e => OnDragStart(e, NodeType.End)"><span
                            class="oi oi-media-stop"></span> Конец
                    </div>
                </div>
            </div>
            <div class="sidebar-section">
                <small>КОНТЕНТ</small>
                <div class="node-grid">
                    <div class="node-tool" draggable="true" @ondragstart="e => OnDragStart(e, NodeType.Message)"><span
                            class="oi oi-chat"></span> Сообщение
                    </div>
                    <div class="node-tool" draggable="true" @ondragstart="e => OnDragStart(e, NodeType.Ask)"><span
                            class="oi oi-question-mark"></span> Вопрос
                    </div>
                    <div class="node-tool" draggable="true" @ondragstart="e => OnDragStart(e, NodeType.Media)"><span
                            class="oi oi-image"></span> Медиа
                    </div>
                </div>
            </div>
            <div class="sidebar-section">
                <small>ИНТЕГРАЦИИ</small>
                <div class="node-grid">
                    <div class="node-tool" draggable="true" @ondragstart="e => OnDragStart(e, NodeType.HttpRequest)">
                        <span class="oi oi-cloud-download"></span> API Запрос
                    </div>
                    <div class="node-tool" draggable="true" @ondragstart="e => OnDragStart(e, NodeType.SetVariable)">
                        <span class="oi oi-list"></span> Переменная
                    </div>
                    <div class="node-tool" draggable="true" @ondragstart="e => OnDragStart(e, NodeType.AIFilter)"><span
                            class="oi oi-eye"></span> AI Фильтр
                    </div>
                    <div class="node-tool" draggable="true" @ondragstart="e => OnDragStart(e, NodeType.AIGenerate)">
                        <span class="oi oi-bolt"></span> AI Текст
                    </div>
                </div>
            </div>
        </div>
        <div class="sidebar-footer">
            <button class="btn btn-primary w-100" @onclick="SaveWorkflow">
                <span class="oi oi-circle-check"></span> Сохранить
            </button>
        </div>
    </div>

    <div class="canvas-wrapper" @ondrop="OnDrop" @ondragover="OnDragOver" @ondragover:preventDefault="true">
        <CascadingValue Value="Diagram">
            <DiagramCanvas>
                <Widgets>
                    <GridWidget Size="25" Mode="GridMode.Point" BackgroundColor="#f9fafb"/>
                    <SelectionBoxWidget/>
                </Widgets>
            </DiagramCanvas>
        </CascadingValue>
    </div>

    @if (SelectedModel != null)
    {
        <div class="designer-settings-panel">
            <div class="panel-header">
                <h6>Настройки</h6>
                <button type="button" class="btn-close" @onclick="() => SelectedModel = null"></button>
            </div>
            <div class="panel-body">
                @if (SelectedModel is NodeModel node)
                {
                    <div class="mb-3">
                        <label class="form-label">Заголовок</label>
                        <input type="text" class="form-control" @bind-value="node.Title" @bind-value:event="oninput"/>
                    </div>

                    @if (node is WorkflowNodeModel { Data: MessageNodeData msgData })
                    {
                        <div class="mb-3">
                            <label class="form-label">Текст сообщения</label>
                            <textarea class="form-control" @bind="msgData.Text" @bind:event="oninput"
                                      rows="4"></textarea>
                        </div>
                    }
                    /* 
                        @if (wfNode.Data is AskNodeData askData)
                        {
                            <div class="mb-3">
                                <label class="form-label">Вопрос</label>
                                <input type="text" class="form-control" @bind="askData.Question" @bind:event="oninput" />
                            </div>
                            // ... UI для Options
                        }
                        */
                }
                else if (SelectedModel is WorkflowLinkModel link)
                {
                    <div class="section-title mb-3 fw-bold">Логика перехода</div>

                    <div class="mb-3">
                        <label class="form-label">Тип условия</label>
                        <select class="form-select"
                                @onchange="@(e => OnConditionTypeChanged(link, e.Value?.ToString()))">
                            <option value="none" selected="@(link.Condition == null)">Без условия (Всегда)</option>
                            <option value="equals" selected="@(link.Condition?.Equals != null)">Равно (==)</option>
                            <option value="contains" selected="@(link.Condition?.Contains != null)">Содержит (*)
                            </option>
                        </select>
                    </div>

                    @if (link.Condition?.Equals != null)
                    {
                        <div class="card p-3 border-primary mb-3 shadow-sm">
                            <div class="mb-2">
                                <label class="small text-muted">Переменная (напр. $client.name)</label>
                                <input type="text" class="form-control" @bind="link.Condition.Equals.Left"/>
                            </div>
                            <div class="text-center my-1"><span class="badge bg-primary">РАВНО</span></div>
                            <div>
                                <label class="small text-muted">Значение</label>
                                <input type="text" class="form-control" @bind="link.Condition.Equals.Right"/>
                            </div>
                        </div>
                    }
                    else if (link.Condition?.Contains != null)
                    {
                        <div class="card p-3 border-success mb-3 shadow-sm">
                            <div class="mb-2">
                                <label class="small text-muted">Переменная</label>
                                <input type="text" class="form-control" @bind="link.Condition.Contains.Left"/>
                            </div>
                            <div class="text-center my-1"><span class="badge bg-success">СОДЕРЖИТ</span></div>
                            <div>
                                <label class="small text-muted">Подстрока</label>
                                <input type="text" class="form-control" @bind="link.Condition.Contains.Right"/>
                            </div>
                        </div>
                    }

                    <div class="mb-3">
                        <label class="form-label">Текст на линии</label>
                        <input type="text" class="form-control" @bind="link.Label" placeholder="Напр: Да / Нет"/>
                    </div>
                }

                <hr/>
                <div class="mt-3">
                    <button class="btn btn-outline-danger w-100" @onclick="DeleteSelectedModel">
                        <span class="oi oi-trash"></span> Удалить
                    </button>
                </div>
            </div>
        </div>
    }
</div>
