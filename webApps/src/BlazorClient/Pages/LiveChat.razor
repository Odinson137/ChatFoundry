@page "/livechat"
@using BlazorClient.Services
@using BlazorClient.Models.DTO
@using BlazorClient.Components
@using Blazored.LocalStorage
@inject INotificationApiClient ApiClient
@inject LiveChatStateService State
@inject SignalRService SignalR
@inject ILocalStorageService LocalStorage

<div class="cf-lc">
    <!-- Sidebar -->
    <div class="cf-lc-sidebar">
        <div class="cf-lc-sidebar-header">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#6366f1" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
            <h3 class="cf-lc-sidebar-title">Live Chat</h3>
        </div>

        @if (State.QueuedChats.Count == 0 && State.MyChats.Count == 0)
        {
            <div class="cf-lc-empty-sidebar">
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#cbd5e1" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
                </svg>
                <p>Нет активных чатов</p>
                <span class="cf-lc-empty-hint">Новые чаты появятся здесь автоматически</span>
            </div>
        }

        @if (State.QueuedChats.Count > 0)
        {
            <div class="cf-lc-section-label">
                <span>Очередь</span>
                <span class="cf-lc-count-badge">@State.QueuedChats.Count</span>
            </div>
            @foreach (var chat in State.QueuedChats)
            {
                <div class="cf-lc-item cf-lc-item-queued" @onclick="() => TakeChat(chat.Id)">
                    <div class="cf-lc-item-avatar">@GetInitials(chat)</div>
                    <div class="cf-lc-item-body">
                        <div class="cf-lc-item-row">
                            <span class="cf-lc-item-name">@(chat.ClientFirstName ?? chat.ClientUserName ?? chat.ExternalUserId)</span>
                            <span class="cf-lc-item-time">@FormatShortTime(chat.CreatedAt)</span>
                        </div>
                        <div class="cf-lc-item-preview">@(FormatPreview(chat.LastMessagePreview) is "" ? "Новый запрос" : FormatPreview(chat.LastMessagePreview))</div>
                        <div class="cf-lc-item-footer">
                            <span class="cf-lc-badge cf-lc-badge-@(chat.Channel.ToLowerInvariant())">@chat.Channel</span>
                        </div>
                    </div>
                    <button class="cf-lc-take-btn" title="Взять чат">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                    </button>
                </div>
            }
        }

        @if (State.MyChats.Count > 0)
        {
            <div class="cf-lc-section-label">
                <span>Мои чаты</span>
                <span class="cf-lc-count-badge">@State.MyChats.Count</span>
            </div>
            @foreach (var chat in State.MyChats)
            {
                <div class="cf-lc-item @((State.SelectedChatId == chat.Id) ? "cf-lc-item-selected" : "")"
                     @onclick="() => SelectChat(chat.Id)">
                    <div class="cf-lc-item-avatar">@GetInitials(chat)</div>
                    <div class="cf-lc-item-body">
                        <div class="cf-lc-item-row">
                            <span class="cf-lc-item-name">@(chat.ClientFirstName ?? chat.ClientUserName ?? chat.ExternalUserId)</span>
                            <span class="cf-lc-item-time">@FormatShortTime(chat.TakenAt)</span>
                        </div>
                        <div class="cf-lc-item-preview">@(FormatPreview(chat.LastMessagePreview) is "" ? "..." : FormatPreview(chat.LastMessagePreview))</div>
                        <div class="cf-lc-item-footer">
                            <span class="cf-lc-badge cf-lc-badge-@(chat.Channel.ToLowerInvariant())">@chat.Channel</span>
                            @if (chat.BotName != null)
                            {
                                <span class="cf-lc-item-bot">бот: @chat.BotName</span>
                            }
                        </div>
                    </div>
                </div>
            }
        }
    </div>

    <!-- Main chat area -->
    <div class="cf-lc-main">
        <!-- Conflict error overlay -->
        @if (!string.IsNullOrEmpty(conflictError))
        {
            <div class="cf-lc-conflict-overlay" @onclick="DismissConflictError">
                <div class="cf-lc-conflict-card" @onclick:stopPropagation>
                    <div class="cf-lc-conflict-icon">
                        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#f59e0b" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10"/>
                            <line x1="12" x2="12" y1="8" y2="12"/>
                            <line x1="12" x2="12.01" y1="16" y2="16"/>
                        </svg>
                    </div>
                    <h3 class="cf-lc-conflict-title">Чат недоступен</h3>
                    <p class="cf-lc-conflict-text">@conflictError</p>
                    <button class="cf-lc-conflict-btn" @onclick="DismissConflictError">Понятно</button>
                </div>
            </div>
        }

        @if (selectedChat != null)
        {
            <!-- Chat header -->
            <div class="cf-lc-header">
                <div class="cf-lc-header-info">
                    <div class="cf-lc-header-avatar">@GetInitials(selectedChat)</div>
                    <div class="cf-lc-header-details">
                        @if (clientPageId.HasValue)
                        {
                            <a href="@($"/clients/{clientPageId}")" class="cf-lc-header-name" target="_blank">@(selectedChat.ClientFirstName ?? selectedChat.ClientUserName ?? selectedChat.ExternalUserId)</a>
                        }
                        else
                        {
                            <span class="cf-lc-header-name">@(selectedChat.ClientFirstName ?? selectedChat.ClientUserName ?? selectedChat.ExternalUserId)</span>
                        }
                        <div class="cf-lc-header-meta">
                            <span class="cf-lc-badge cf-lc-badge-@(selectedChat.Channel.ToLowerInvariant()) cf-lc-badge-sm">@selectedChat.Channel</span>
                            @if (selectedChat.BotName != null)
                            {
                                <span class="cf-lc-header-bot">бот: @selectedChat.BotName</span>
                            }
                        </div>
                    </div>
                </div>
                <button class="cf-lc-close-btn" @onclick="CloseChat">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
                    Завершить чат
                </button>
            </div>

            <!-- Messages -->
            <div class="cf-lc-messages" @ref="_messagesContainer">
                @if (isLoadingMessages)
                {
                    <div class="cf-lc-loading-messages">
                        <div class="cf-lc-spinner"></div>
                        <p>Загрузка сообщений...</p>
                    </div>
                }
                else if (messages.Count == 0)
                {
                    <div class="cf-lc-empty-messages">
                        <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#cbd5e1" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M7.9 20A9 9 0 1 0 4 16.1L2 22z"/>
                        </svg>
                        <p>Начните диалог</p>
                    </div>
                }
                else
                {
                    @RenderMessages(messages, selectedChat!)
                }
            </div>

            <!-- Send error -->
            @if (!string.IsNullOrEmpty(sendError))
            {
                <div class="cf-lc-send-error">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" x2="12" y1="8" y2="12"/><line x1="12" x2="12.01" y1="16" y2="16"/></svg>
                    @sendError
                </div>
            }

            <!-- Input -->
            <div class="cf-lc-input">
                <textarea class="cf-lc-input-field"
                          @ref="_inputField"
                          @oninput="HandleTextInput"
                          @onkeydown="OnKeyDown"
                          placeholder="Введите сообщение..."
                          rows="1"
                          disabled="@isSending" />
                <button class="cf-lc-send-btn" @onclick="SendMessage"
                        disabled="@(isSending || string.IsNullOrWhiteSpace(messageText))">
                    @if (isSending)
                    {
                        <div class="cf-lc-spinner-sm"></div>
                    }
                    else
                    {
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="m5 12 7-7 7 7"/>
                            <path d="M12 19V5"/>
                        </svg>
                    }
                </button>
            </div>
        }
        else
        {
            <div class="cf-lc-empty-main">
                <svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="#cbd5e1" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
                </svg>
                <h3>Выберите чат</h3>
                <p>Возьмите чат из очереди или выберите из активных</p>
            </div>
        }
    </div>
</div>
