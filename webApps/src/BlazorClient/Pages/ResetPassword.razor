@page "/reset-password"
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>Новый пароль — ChatFoundry</PageTitle>

<div class="confirm-email-page">
    <div class="confirm-email-bg" aria-hidden="true"></div>
    <div class="confirm-email-card">
        @if (loading)
        {
            <div class="confirm-email-icon confirm-email-icon-loading">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="11" width="18" height="11" rx="2"/>
                    <path d="M7 11V7a5 5 0 0110 0v4"/>
                </svg>
            </div>
            <h1 class="confirm-email-title">Загрузка...</h1>
            <div class="confirm-email-spinner"></div>
        }
        else if (success)
        {
            <div class="confirm-email-icon confirm-email-icon-success">
                <svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"/>
                    <path d="m9 12 2 2 4-4"/>
                </svg>
            </div>
            <h1 class="confirm-email-title">Пароль изменён</h1>
            <p class="confirm-email-subtitle">Теперь вы можете войти с новым паролем.</p>
            <a href="/login" class="confirm-email-btn">Войти в аккаунт</a>
        }
        else if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="confirm-email-icon confirm-email-icon-error">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"/>
                    <line x1="12" y1="8" x2="12" y2="12"/>
                    <line x1="12" y1="16" x2="12.01" y2="16"/>
                </svg>
            </div>
            <h1 class="confirm-email-title confirm-email-title-error">Ошибка</h1>
            <p class="confirm-email-subtitle">@errorMessage</p>
            <a href="/forgot-password" class="confirm-email-btn confirm-email-btn-secondary">Запросить ссылку снова</a>
        }
        else
        {
            <div class="confirm-email-icon">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="11" width="18" height="11" rx="2"/>
                    <path d="M7 11V7a5 5 0 0110 0v4"/>
                </svg>
            </div>
            <h1 class="confirm-email-title">Новый пароль</h1>
            <p class="confirm-email-subtitle">Введите новый пароль и подтвердите его.</p>

            @if (!string.IsNullOrEmpty(formError))
            {
                <div class="login-error" style="margin-bottom: 1rem;">
                    <span>@formError</span>
                </div>
            }

            <div class="login-form" style="text-align: left;">
                <div class="login-field">
                    <label class="login-label" for="newPassword">Новый пароль</label>
                    <div class="login-input-wrap">
                        <svg class="login-input-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="3" y="11" width="18" height="11" rx="2"/>
                            <path d="M7 11V7a5 5 0 0110 0v4"/>
                        </svg>
                        <input id="newPassword"
                               type="password"
                               class="login-input"
                               placeholder="Новый пароль"
                               @bind="newPassword"
                               @onkeydown="OnKeyDown" />
                    </div>
                </div>
                <div class="login-field">
                    <label class="login-label" for="confirmPassword">Повторите пароль</label>
                    <div class="login-input-wrap">
                        <svg class="login-input-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="3" y="11" width="18" height="11" rx="2"/>
                            <path d="M7 11V7a5 5 0 0110 0v4"/>
                        </svg>
                        <input id="confirmPassword"
                               type="password"
                               class="login-input"
                               placeholder="Повторите пароль"
                               @bind="confirmPassword"
                               @onkeydown="OnKeyDown" />
                    </div>
                </div>
                <button class="login-btn" @onclick="HandleSubmit" disabled="@isSubmitting">
                    @if (isSubmitting)
                    {
                        <span class="login-spinner"></span>
                    }
                    else
                    {
                        <span>Сохранить пароль</span>
                    }
                </button>
            </div>

            <div class="login-footer" style="margin-top: 1.5rem;">
                <a href="/login">На страницу входа</a>
            </div>
        }
    </div>
</div>

@code {
    [SupplyParameterFromQuery] public string? UserId { get; set; }
    [SupplyParameterFromQuery] public string? Token { get; set; }

    private bool loading = true;
    private bool success;
    private string? errorMessage;
    private string? formError;
    private string newPassword = "";
    private string confirmPassword = "";
    private bool isSubmitting;

    protected override void OnInitialized()
    {
        if (string.IsNullOrWhiteSpace(UserId) || string.IsNullOrWhiteSpace(Token))
        {
            errorMessage = "Неверная или устаревшая ссылка. Запросите новую.";
        }
        loading = false;
    }

    protected override void OnParametersSet()
    {
        if (!success && string.IsNullOrEmpty(errorMessage) && (string.IsNullOrWhiteSpace(UserId) || string.IsNullOrWhiteSpace(Token)))
            errorMessage = "Неверная или устаревшая ссылка. Запросите новую.";
    }

    private async Task HandleSubmit()
    {
        formError = null;
        if (string.IsNullOrWhiteSpace(newPassword))
        {
            formError = "Введите новый пароль.";
            return;
        }
        if (newPassword != confirmPassword)
        {
            formError = "Пароли не совпадают.";
            return;
        }
        if (string.IsNullOrWhiteSpace(UserId) || string.IsNullOrWhiteSpace(Token))
        {
            errorMessage = "Неверная или устаревшая ссылка.";
            return;
        }

        isSubmitting = true;
        try
        {
            var payload = new
            {
                userId = UserId,
                token = Token,
                newPassword = newPassword
            };
            var response = await Http.PostAsJsonAsync($"{ApiEndpoints.Api}/identity/auth/reset-password", payload);
            var json = await response.Content.ReadFromJsonAsync<ResetPasswordResponse>();
            if (json?.Succeeded == true)
                success = true;
            else
                formError = json?.Message ?? "Ссылка недействительна или устарела. Запросите новую.";
        }
        catch
        {
            formError = "Не удалось сохранить пароль. Попробуйте позже.";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await HandleSubmit();
    }

    private class ResetPasswordResponse
    {
        public bool Succeeded { get; set; }
        public string? Message { get; set; }
    }
}
