@using Microsoft.AspNetCore.Components.Authorization
@inherits LayoutComponentBase

<div class="page">
    <main>
        <div class="top-row px-4">
            <NavMenu />
            <AuthorizeView>
                <Authorized>
                    <a href="/logout">Выйти</a>
                </Authorized>
                <NotAuthorized>
                    <a href="/login">Войти / Регистрация</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>